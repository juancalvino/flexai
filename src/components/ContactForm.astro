---
import { Icon } from "astro-icon/components";
import { ZONE_LIST } from "../data/zones";
import LocalityAutocomplete from "./LocalityAutocomplete.astro";

interface Props {
  presetIntent?: "services" | "work";
  hideIntent?: boolean;
  quoteMode?: boolean;
  selectionMode?: boolean;
}

const { presetIntent, hideIntent = false, quoteMode = false, selectionMode = false } = Astro.props;

const zoneNames = ZONE_LIST.map((zone) => zone.name);
const packageSizes = [
  { value: "Pequeño", hint: "hasta 30 cm · ~5 kg" },
  { value: "Mediano", hint: "hasta 60 cm · ~15 kg" },
  { value: "Grande", hint: "hasta 80 cm · ~30 kg" },
];
const vehicleTypes = ["Moto", "Auto", "Camioneta / Utilitario", "Camión"];
const weekdays = ["Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"];
const timeBands = ["Mañana", "Tarde/noche"];

const fieldClass =
  "mt-2 w-full rounded-xl border border-ink/15 bg-cream px-4 py-3 text-ink shadow-sm placeholder:text-ink/35 transition-colors focus:outline-none focus:border-secondary focus:ring-2 focus:ring-secondary/30";
const labelClass = "eyebrow text-ink/75";
const captionClass = `${labelClass} block sm:min-h-8 md:min-h-0`;

const checkboxClass =
  "flex min-h-11 cursor-pointer items-center gap-2 rounded-xl border border-ink/15 bg-cream px-3 py-2 transition-colors hover:border-secondary has-[:checked]:border-secondary has-[:checked]:bg-secondary/10 has-[:checked]:ring-1 has-[:checked]:ring-secondary has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-secondary has-[:focus-visible]:ring-offset-2";

const choiceCardClass =
  "flex cursor-pointer items-center gap-3 rounded-xl border border-ink/15 bg-cream px-4 py-3 transition-colors hover:border-ink/40 has-[:checked]:border-secondary has-[:checked]:bg-secondary/10 has-[:checked]:ring-1 has-[:checked]:ring-secondary has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-secondary has-[:focus-visible]:ring-offset-2";
---

<form
  id="contact-form"
  class="grid gap-6 rounded-3xl bg-cream-light p-5 ring-1 ring-ink/10 sm:grid-cols-2 sm:gap-x-6 sm:gap-y-8 sm:p-8 md:p-10"
  data-preset-intent={presetIntent}
  data-hide-intent={hideIntent}
  data-quote-mode={quoteMode}
  data-selection-mode={selectionMode}
  method="post"
  novalidate
>
  <div class="border-b border-ink/10 pb-5 sm:col-span-2">
    <h2 id="contact-form-heading" tabindex="-1" class="scroll-mt-24 font-display text-2xl uppercase tracking-wide">Contanos un poco más</h2>
    <p class="mt-2 text-sm leading-relaxed text-ink/65">{quoteMode
      ? "Completá todos los campos con * para conocer el plan que corresponde a tu volumen. No abriremos WhatsApp hasta que lo elijas."
      : "Completá los campos con * y prepararemos tu mensaje para WhatsApp o, si te postulás a otro puesto, por correo. Podés revisarlo antes de enviarlo."}</p>
  </div>
  {!hideIntent && !selectionMode && (
    <fieldset id="fieldset-intent" class="sm:col-span-2">
      <legend class={labelClass}>¿Qué te gustaría hacer? *</legend>
      <div class="mt-2 grid gap-3 sm:grid-cols-2">
        <label class={choiceCardClass}>
          <input type="radio" name="intent" value="services" checked required class="size-4 shrink-0 accent-secondary" />
          <span>
            <span class="block font-display text-sm font-medium uppercase tracking-wider">Contratar el servicio</span>
            <span class="block text-sm text-ink/60">Quiero realizar envíos con FLEXAI</span>
          </span>
        </label>
        <label class={choiceCardClass}>
          <input type="radio" name="intent" value="work" required class="size-4 shrink-0 accent-secondary" />
          <span>
            <span class="block font-display text-sm font-medium uppercase tracking-wider">Trabajar con nosotros</span>
            <span class="block text-sm text-ink/60">Quiero ser parte del equipo</span>
          </span>
        </label>
      </div>
    </fieldset>
  )}

  <label class="block">
    <span class={captionClass}>Nombre y apellido *</span>
    <input name="name" type="text" required autocomplete="name" class={fieldClass} />
  </label>
  <label class="block">
    <span class={captionClass}>Telefono (Opcional)</span>
    <input name="phone" type="tel" autocomplete="tel" inputmode="tel" pattern="[0-9 +\\-\\(\\)]{8,}" class={fieldClass} />
  </label>

  <fieldset id="fieldset-services" class="grid gap-6 sm:col-span-2 sm:grid-cols-2">
    <legend class="mb-5 w-full border-t border-ink/10 pt-6 font-display text-xl uppercase tracking-wide">Datos de tus envíos</legend>
    <label class="block">
      <span class={captionClass}>Nombre de la empresa *</span>
      <input name="store" type="text" required autocomplete="organization" class={fieldClass} />
    </label>
    <LocalityAutocomplete name="locality" label="Barrio / localidad de colecta" inputClass={fieldClass} labelClass={captionClass} />
    <label class="block">
      <span class={captionClass}>Paquetes por día *</span>
      <input name="volume" type="number" min="1" step="1" required placeholder="Ej: 30" class={fieldClass} />
    </label>
    <fieldset class="sm:col-span-2" data-required-group="deliveryZones" aria-describedby="delivery-zones-error">
      <legend class={labelClass}>Zonas de entrega *</legend>
      <p class="mt-1 text-sm text-ink/60">Podés elegir más de una zona.</p>
      <div class="mt-2 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {zoneNames.map((zone) => (
          <label class:list={[choiceCardClass, "justify-center text-center"]}>
            <input type="checkbox" name="deliveryZones" value={zone} aria-describedby="delivery-zones-error" class="size-4 shrink-0 accent-secondary" />
            <span class="font-display text-sm font-medium uppercase tracking-wider">{zone}</span>
          </label>
        ))}
      </div>
      <p id="delivery-zones-error" class="hidden mt-3 text-sm text-red-700">Elegí al menos una zona de entrega.</p>
    </fieldset>
    <fieldset class="sm:col-span-2">
      <legend class={labelClass}>Tamaño promedio de tus paquetes *</legend>
      <div class="mt-2 grid gap-3 sm:grid-cols-3">
        {packageSizes.map((size) => (
          <label class={choiceCardClass}>
            <input type="radio" name="size" value={size.value} required class="size-4 shrink-0 accent-secondary" />
            <span>
              <span class="block font-display text-sm font-medium uppercase tracking-wider">{size.value}</span>
              <span class="block text-xs text-ink/60">{size.hint}</span>
            </span>
          </label>
        ))}
      </div>
      <p class="mt-3 text-sm leading-relaxed text-ink/60">Referencias aproximadas de FLEXAI (lado mayor y peso), no categorías oficiales de Mercado Libre.</p>
    </fieldset>
  </fieldset>

  <fieldset id="fieldset-work" class="hidden grid gap-6 sm:col-span-2 sm:grid-cols-2" disabled>
    <legend class="mb-5 w-full border-t border-ink/10 pt-6 font-display text-xl uppercase tracking-wide">Tu perfil</legend>

    <fieldset class="sm:col-span-2">
      <legend class={labelClass}>¿Sos conductor/a? *</legend>
      <div class="mt-2 grid gap-3 sm:grid-cols-2">
        <label class={choiceCardClass}>
          <input type="radio" name="driver" value="yes" required class="size-4 shrink-0 accent-secondary" />
          <span class="font-display text-sm font-medium uppercase tracking-wider">Sí, soy conductor/a</span>
        </label>
        <label class={choiceCardClass}>
          <input type="radio" name="driver" value="no" required class="size-4 shrink-0 accent-secondary" />
          <span class="font-display text-sm font-medium uppercase tracking-wider">No, otro puesto</span>
        </label>
      </div>
    </fieldset>

    <fieldset id="fieldset-non-driver" class="hidden sm:col-span-2" disabled>
      <label class="block">
        <span class={captionClass}>Puesto al que te postulás *</span>
        <input name="position" type="text" required class={fieldClass} />
      </label>
      <p class="mt-3 text-sm leading-relaxed text-ink/60">Se abrirá tu aplicación de correo con tus datos. Adjuntá tu CV manualmente antes de enviarlo.</p>
    </fieldset>

    <fieldset id="fieldset-driver-details" class="hidden grid gap-6 sm:col-span-2 sm:grid-cols-2" disabled>
      <legend class="mb-5 font-display text-lg uppercase tracking-wide">Vehículo y disponibilidad</legend>
      <LocalityAutocomplete name="originZone" label="Barrio / localidad de origen" inputClass={fieldClass} labelClass={captionClass} />
      <label class="block">
        <span class={captionClass}>Zona de interés *</span>
        <select name="interestZone" required class={fieldClass}>
          <option value="">Seleccioná una zona</option>
          {zoneNames.map((zone) => <option value={zone}>{zone}</option>)}
        </select>
      </label>
      <label class="block">
        <span class={captionClass}>Vehículo *</span>
        <select name="vehicle" required class={fieldClass}>
          <option value="">Seleccioná tu vehículo</option>
          {vehicleTypes.map((item) => <option value={item}>{item}</option>)}
        </select>
      </label>
      <label class="block">
        <span class={captionClass}>Marca del vehículo *</span>
        <input name="vehicleBrand" type="text" required placeholder="Ej: Ford" class={fieldClass} />
      </label>
      <label class="block">
        <span class={captionClass}>Modelo del vehículo *</span>
        <input name="vehicleModel" type="text" required placeholder="Ej: Transit" class={fieldClass} />
      </label>
      <label class="block">
        <span class={captionClass}>Año del vehículo *</span>
        <input name="vehicleYear" type="number" min="1886" step="1" required placeholder="Ej: 2015" class={fieldClass} />
      </label>
      <fieldset class="sm:col-span-2" data-required-group="availabilityDays" aria-describedby="availability-days-error">
        <legend class={labelClass}>Disponibilidad semanal *</legend>
        <div class="mt-2 flex flex-wrap gap-2">
          {weekdays.map((day) => (
            <label class={checkboxClass}>
              <input type="checkbox" name="availabilityDays" value={day} aria-describedby="availability-days-error" class="size-4 shrink-0 accent-secondary" />
              <span class="text-sm">{day}</span>
            </label>
          ))}
        </div>
        <p id="availability-days-error" class="hidden mt-3 text-sm text-red-700">Elegí al menos un día de disponibilidad.</p>
      </fieldset>
      <label class="block sm:col-span-2">
        <span class={captionClass}>Horario *</span>
        <select name="availabilityTime" required class={fieldClass}>
          <option value="">Seleccioná un horario</option>
          {timeBands.map((item) => <option value={item}>{item}</option>)}
        </select>
      </label>
    </fieldset>

  </fieldset>

  <p id="form-error" class="hidden text-sm text-red-700 sm:col-span-2" role="alert">
    Revisá los campos marcados con * antes de enviar.
  </p>

  <button type="submit" disabled class="btn-dark min-h-12 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary sm:col-span-2">
    <span id="submit-whatsapp-icon" aria-hidden="true" class:list={[{ hidden: quoteMode }]}><Icon name="simple-icons:whatsapp" class="h-4 w-4" /></span>
    <span id="submit-email-icon" aria-hidden="true" class="hidden">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3 6 9 7 9-7" />
      </svg>
    </span>
    <span id="submit-label">{quoteMode ? "Ver mi plan" : "Enviar por WhatsApp"}</span>
  </button>
  <noscript><p>Activá JavaScript para validar tus datos y preparar tu consulta sin incluirlos en la dirección de esta página.</p></noscript>
</form>

<div id="form-success" class="hidden rounded-3xl bg-ink p-10 text-cream" role="status" tabindex="-1">
  <p class="eyebrow text-accent">Listo</p>
  <h2 class="mt-4 font-display text-4xl uppercase">¡Gracias por escribirnos!</h2>
  <p class="mt-4 text-cream/70">
    <span id="form-success-message">Tu mensaje está preparado. Revisalo y envialo desde WhatsApp.</span> Si no se abrió, <a id="form-fallback" class="text-accent underline" target="_blank" rel="noopener noreferrer" href="#">tocá acá</a>.
  </p>
  <a href="/" class="btn-ghost mt-8">Volver al inicio</a>
</div>

<script>
  import { SITE, whatsappUrl } from "../data/site";
  import { buildContactMessage, buildCvEmailUrl, contactFieldError } from "../lib/contact-message";

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const error = document.getElementById("form-error")!;
  const success = document.getElementById("form-success")!;
  const successMessage = document.getElementById("form-success-message")!;
  const fallback = document.getElementById("form-fallback") as HTMLAnchorElement;
  const quoteMode = form.dataset.quoteMode === "true";
  const result = document.getElementById("qualified-result");

  const intentInputs = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="intent"]'));
  const driverInputs = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="driver"]'));
  const servicesFieldset = document.getElementById("fieldset-services") as HTMLFieldSetElement;
  const workFieldset = document.getElementById("fieldset-work") as HTMLFieldSetElement;
  const driverDetailsFieldset = document.getElementById("fieldset-driver-details") as HTMLFieldSetElement;
  const nonDriverFieldset = document.getElementById("fieldset-non-driver") as HTMLFieldSetElement;

  const parseIntent = (value: string | null | undefined) =>
    value === "services" || value === "work" ? value : undefined;
  const preset = parseIntent(form.dataset.presetIntent);
  const requested = parseIntent(new URLSearchParams(window.location.search).get("intent"));
  const selectionMode = form.dataset.selectionMode === "true" && !preset;
  let intent = preset ?? requested ?? (selectionMode ? undefined : "services");
  const locked = Boolean(preset) || selectionMode || requested === "services" || form.dataset.hideIntent === "true";
  const section = selectionMode ? document.getElementById("formulario") : null;
  const heading = document.getElementById("contact-form-heading")!;
  const choices = selectionMode ? Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-contact-intent]")) : [];
  const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const submitLabel = document.getElementById("submit-label")!;
  const whatsappIcon = document.getElementById("submit-whatsapp-icon")!;
  const emailIcon = document.getElementById("submit-email-icon")!;
  const intentFieldset = document.getElementById("fieldset-intent") as HTMLFieldSetElement | null;
  if (intentFieldset) {
    intentFieldset.classList.toggle("hidden", locked);
    intentFieldset.disabled = locked;
  }
  intentInputs.forEach((input) => { input.checked = input.value === intent; });

  const controls = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input, select"));
  const requiredGroups = Array.from(form.querySelectorAll<HTMLFieldSetElement>("[data-required-group]"));
  let submitted = false;

  const validate = (showErrors: boolean) => {
    let valid = true;
    controls.forEach((field) => {
      field.setCustomValidity(field.matches(":disabled") ? "" : contactFieldError(field));
      const invalid = !field.matches(":disabled") && !field.checkValidity();
      valid = valid && !invalid;
      field.setAttribute("aria-invalid", String(showErrors && invalid));
      field.classList.toggle("!border-red-600", showErrors && invalid);
    });
    requiredGroups.forEach((group) => {
      const checkboxes = Array.from(group.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));
      const invalid = checkboxes.some((input) => !input.matches(":disabled")) && !checkboxes.some((input) => input.checked);
      valid = valid && !invalid;
      group.setAttribute("aria-invalid", String(showErrors && invalid));
      checkboxes.forEach((input) => input.setAttribute("aria-invalid", String(showErrors && invalid)));
      document.getElementById(group.getAttribute("aria-describedby")!)?.classList.toggle("hidden", !showErrors || !invalid);
    });
    error.classList.toggle("hidden", !showErrors || valid);
    return valid;
  };

  const applyState = () => {
    if (!locked) intent = parseIntent(intentInputs.find((input) => input.checked)?.value) ?? intent;
    form.dataset.intent = intent ?? "";
    submitButton.disabled = !intent;
    servicesFieldset.disabled = intent !== "services";
    servicesFieldset.classList.toggle("hidden", intent !== "services");
    workFieldset.disabled = intent !== "work";
    workFieldset.classList.toggle("hidden", intent !== "work");

    const driver = driverInputs.find((input) => input.checked)?.value;
    const showDriver = intent === "work" && driver === "yes";
    driverDetailsFieldset.disabled = !showDriver;
    driverDetailsFieldset.classList.toggle("hidden", !showDriver);
    const showNonDriver = intent === "work" && driver === "no";
    nonDriverFieldset.disabled = !showNonDriver;
    nonDriverFieldset.classList.toggle("hidden", !showNonDriver);
    submitLabel.textContent = quoteMode ? "Ver mi plan" : showNonDriver ? "Enviar CV" : "Enviar por WhatsApp";
    whatsappIcon.classList.toggle("hidden", quoteMode || showNonDriver);
    emailIcon.classList.toggle("hidden", quoteMode || !showNonDriver);
    submitted = false;
    validate(false);
  };
  applyState();

  // The landing owns the choice gate; explicit presets (including /planes) bypass it.
  const revealSelection = () => {
    if (!section || !intent) return;
    section.hidden = false;
    form.classList.remove("hidden");
    success.classList.add("hidden");
    fallback.href = "#";
    choices.forEach((choice) => {
      choice.setAttribute("aria-expanded", String(choice.dataset.contactIntent === intent));
    });
    // Reveal first: native fragment navigation may have run while the section was hidden.
    requestAnimationFrame(() => {
      heading.focus({ preventScroll: true });
      heading.scrollIntoView({ block: "start", behavior: "instant" });
    });
  };
  revealSelection();
  choices.forEach((choice) => choice.addEventListener("click", (event) => {
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const selected = parseIntent(choice.dataset.contactIntent);
    if (!selected) return;
    event.preventDefault();
    intent = selected;
    // Only the public intent/anchor is retained; entered data stays in the form.
    window.history.replaceState(null, "", choice.href);
    applyState();
    revealSelection();
  }));

  intentInputs.forEach((input) => input.addEventListener("change", applyState));
  driverInputs.forEach((input) => input.addEventListener("change", applyState));
  const clearQualification = () => {
    if (!quoteMode) return;
    result?.dispatchEvent(new Event("contact:clear"));
    form.classList.remove("hidden");
  };
  const onEdit = () => {
    clearQualification();
    if (submitted) validate(true);
  };
  form.addEventListener("input", onEdit);
  form.addEventListener("change", onEdit);
  result?.addEventListener("contact:edit", () => {
    clearQualification();
    submitted = false;
    validate(false);
    form.querySelector<HTMLInputElement>('[name="name"]')?.focus();
  });

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!intent) return;

    submitted = true;
    if (!validate(true)) {
      const firstInvalid = controls.find((field) => field.getAttribute("aria-invalid") === "true");
      firstInvalid?.focus();
      firstInvalid?.reportValidity();
      return;
    }

    const data = new FormData(form);
    if (quoteMode) {
      if (intent !== "services" || !result) return;
      const qualified = new CustomEvent("contact:qualified", { detail: data, cancelable: true });
      result.dispatchEvent(qualified);
      if (qualified.defaultPrevented) form.classList.add("hidden");
      return;
    }
    const sendCv = intent === "work" && data.get("driver") === "no";
    const url = sendCv ? buildCvEmailUrl(data, SITE.email) : whatsappUrl(buildContactMessage(data, intent));
    successMessage.textContent = sendCv
      ? "Tu correo está preparado. Adjuntá tu CV, revisá tus datos y envialo desde tu aplicación de correo."
      : "Tu mensaje está preparado. Revisalo y envialo desde WhatsApp.";
    fallback.href = url;
    window.open(url, "_blank", "noopener");

    form.classList.add("hidden");
    success.classList.remove("hidden");
    success.focus();
  });
</script>
