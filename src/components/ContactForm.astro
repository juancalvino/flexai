---
import { Icon } from "astro-icon/components";
import { ZONE_LIST } from "../data/zones";

interface Props {
  presetIntent?: "services" | "work";
  hideIntent?: boolean;
}

const { presetIntent, hideIntent = false } = Astro.props;

const zoneNames = ZONE_LIST.map((zone) => zone.name);
const packageSizes = [
  { value: "Pequeño", hint: "hasta 30 cm · ~5 kg" },
  { value: "Mediano", hint: "hasta 60 cm · ~15 kg" },
  { value: "Grande", hint: "hasta 80 cm · ~30 kg" },
];
const vehicleTypes = ["Moto", "Auto", "Camioneta / Utilitario", "Camión"];
const vehicleSizes = ["Chico", "Mediano", "Grande"];
const weekdays = ["Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"];
const timeBands = ["Mañana", "Tarde", "Noche", "Horario completo"];

const fieldClass =
  "mt-2 w-full rounded-xl border border-ink/15 bg-cream px-4 py-3 text-ink shadow-sm placeholder:text-ink/35 transition-colors focus:outline-none focus:border-secondary focus:ring-2 focus:ring-secondary/30";
const labelClass = "eyebrow text-ink/75";

const checkboxClass =
  "flex min-h-11 cursor-pointer items-center gap-2 rounded-xl border border-ink/15 bg-cream px-3 py-2 transition-colors hover:border-secondary has-[:checked]:border-secondary has-[:checked]:bg-secondary/10 has-[:checked]:ring-1 has-[:checked]:ring-secondary has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-secondary has-[:focus-visible]:ring-offset-2";

const choiceCardClass =
  "flex cursor-pointer items-center gap-3 rounded-xl border border-ink/15 bg-cream px-4 py-3 transition-colors hover:border-ink/40 has-[:checked]:border-secondary has-[:checked]:bg-secondary/10 has-[:checked]:ring-1 has-[:checked]:ring-secondary has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-secondary has-[:focus-visible]:ring-offset-2";
---

<form
  id="contact-form"
  class="grid gap-6 rounded-3xl bg-cream-light p-5 ring-1 ring-ink/10 sm:grid-cols-2 sm:gap-x-6 sm:gap-y-8 sm:p-8 md:p-10"
  data-preset-intent={presetIntent}
  data-hide-intent={hideIntent}
  novalidate
>
  <div class="border-b border-ink/10 pb-5 sm:col-span-2">
    <h2 class="font-display text-2xl uppercase tracking-wide">Contanos un poco más</h2>
    <p class="mt-2 text-sm leading-relaxed text-ink/65">Completá los campos con * y prepararemos tu consulta para WhatsApp. Podés revisar el mensaje antes de enviarlo.</p>
  </div>
  {!hideIntent && (
    <fieldset id="fieldset-intent" class="sm:col-span-2">
      <legend class={labelClass}>¿Qué te gustaría hacer? *</legend>
      <div class="mt-2 grid gap-3 sm:grid-cols-2">
        <label class={choiceCardClass}>
          <input type="radio" name="intent" value="services" checked required class="size-4 shrink-0 accent-secondary" />
          <span>
            <span class="block font-display text-sm font-medium uppercase tracking-wider">Contratar el servicio</span>
            <span class="block text-sm text-ink/60">Quiero enviar con FLEXAI</span>
          </span>
        </label>
        <label class={choiceCardClass}>
          <input type="radio" name="intent" value="work" required class="size-4 shrink-0 accent-secondary" />
          <span>
            <span class="block font-display text-sm font-medium uppercase tracking-wider">Trabajar con nosotros</span>
            <span class="block text-sm text-ink/60">Quiero ser parte del equipo</span>
          </span>
        </label>
      </div>
    </fieldset>
  )}

  <label class="block">
    <span class={labelClass}>Nombre y apellido *</span>
    <input name="name" type="text" required autocomplete="name" class={fieldClass} />
  </label>
  <label class="block">
    <span class={labelClass}>Teléfono *</span>
    <input name="phone" type="tel" required autocomplete="tel" inputmode="tel" pattern="[0-9 +\\-\\(\\)]{8,}" class={fieldClass} />
  </label>

  <fieldset id="fieldset-services" class="grid gap-6 sm:col-span-2 sm:grid-cols-2">
    <legend class="mb-5 w-full border-t border-ink/10 pt-6 font-display text-xl uppercase tracking-wide">Datos de tus envíos</legend>
    <label class="block">
      <span class={labelClass}>Nombre de la empresa *</span>
      <input name="store" type="text" required autocomplete="organization" class={fieldClass} />
    </label>
    <label class="block">
      <span class={labelClass}>Zona de colecta *</span>
      <select name="locality" required class={fieldClass}>
        <option value="">Seleccioná una zona</option>
        {zoneNames.map((zone) => <option value={zone}>{zone}</option>)}
      </select>
    </label>
    <label class="block">
      <span class={labelClass}>Paquetes por día *</span>
      <input name="volume" type="number" min="1" step="1" required placeholder="Ej: 30" class={fieldClass} />
    </label>
    <fieldset class="sm:col-span-2" data-required-group="deliveryZones" aria-describedby="delivery-zones-error">
      <legend class={labelClass}>Zonas de entrega *</legend>
      <p class="mt-1 text-sm text-ink/60">Podés elegir más de una zona.</p>
      <div class="mt-2 flex flex-wrap gap-2">
        {zoneNames.map((zone) => (
          <label class={checkboxClass}>
            <input type="checkbox" name="deliveryZones" value={zone} aria-describedby="delivery-zones-error" class="size-4 shrink-0 accent-secondary" />
            <span class="text-sm">{zone}</span>
          </label>
        ))}
      </div>
      <p id="delivery-zones-error" class="hidden mt-3 text-sm text-red-700">Elegí al menos una zona de entrega.</p>
    </fieldset>
    <fieldset class="sm:col-span-2">
      <legend class={labelClass}>Tamaño promedio de tus paquetes *</legend>
      <div class="mt-2 grid gap-3 sm:grid-cols-3">
        {packageSizes.map((size) => (
          <label class={choiceCardClass}>
            <input type="radio" name="size" value={size.value} required class="size-4 shrink-0 accent-secondary" />
            <span>
              <span class="block font-display text-sm font-medium uppercase tracking-wider">{size.value}</span>
              <span class="block text-xs text-ink/60">{size.hint}</span>
            </span>
          </label>
        ))}
      </div>
      <p class="mt-3 text-sm leading-relaxed text-ink/60">Referencias aproximadas de FLEXAI (lado mayor y peso), no categorías oficiales de Mercado Libre. Si tus paquetes son más grandes, contanos en el mensaje para evaluar el envío.</p>
    </fieldset>
    <label class="block sm:col-span-2">
      <span class={labelClass}>Link de tu tienda en Mercado Libre</span>
      <input name="url" type="url" placeholder="https://" class={fieldClass} />
    </label>
    <label class="block sm:col-span-2">
      <span class={labelClass}>Mensaje</span>
      <textarea name="message" rows="4" class={fieldClass}></textarea>
    </label>
  </fieldset>

  <fieldset id="fieldset-work" class="hidden grid gap-6 sm:col-span-2 sm:grid-cols-2" disabled>
    <legend class="mb-5 w-full border-t border-ink/10 pt-6 font-display text-xl uppercase tracking-wide">Tu perfil</legend>

    <fieldset class="sm:col-span-2">
      <legend class={labelClass}>¿Sos conductor/a? *</legend>
      <div class="mt-2 grid gap-3 sm:grid-cols-2">
        <label class={choiceCardClass}>
          <input type="radio" name="driver" value="yes" required class="size-4 shrink-0 accent-secondary" />
          <span class="font-display text-sm font-medium uppercase tracking-wider">Sí, soy conductor/a</span>
        </label>
        <label class={choiceCardClass}>
          <input type="radio" name="driver" value="no" required class="size-4 shrink-0 accent-secondary" />
          <span class="font-display text-sm font-medium uppercase tracking-wider">No, otro puesto</span>
        </label>
      </div>
    </fieldset>

    <fieldset id="fieldset-driver-details" class="hidden grid gap-6 sm:col-span-2 sm:grid-cols-2" disabled>
      <legend class="mb-5 font-display text-lg uppercase tracking-wide">Vehículo y disponibilidad</legend>
      <label class="block">
        <span class={labelClass}>Zona de origen *</span>
        <select name="originZone" required class={fieldClass}>
          <option value="">Seleccioná una zona</option>
          {zoneNames.map((zone) => <option value={zone}>{zone}</option>)}
        </select>
      </label>
      <label class="block">
        <span class={labelClass}>Zona de interés *</span>
        <select name="interestZone" required class={fieldClass}>
          <option value="">Seleccioná una zona</option>
          {zoneNames.map((zone) => <option value={zone}>{zone}</option>)}
        </select>
      </label>
      <label class="block">
        <span class={labelClass}>Vehículo *</span>
        <select name="vehicle" required class={fieldClass}>
          <option value="">Seleccioná tu vehículo</option>
          {vehicleTypes.map((item) => <option value={item}>{item}</option>)}
        </select>
      </label>
      <label class="block">
        <span class={labelClass}>Tamaño del vehículo *</span>
        <select name="vehicleSize" required class={fieldClass}>
          <option value="">Seleccioná el tamaño</option>
          {vehicleSizes.map((item) => <option value={item}>{item}</option>)}
        </select>
      </label>
      <fieldset class="sm:col-span-2" data-required-group="availabilityDays" aria-describedby="availability-days-error">
        <legend class={labelClass}>Disponibilidad semanal *</legend>
        <div class="mt-2 flex flex-wrap gap-2">
          {weekdays.map((day) => (
            <label class={checkboxClass}>
              <input type="checkbox" name="availabilityDays" value={day} aria-describedby="availability-days-error" class="size-4 shrink-0 accent-secondary" />
              <span class="text-sm">{day}</span>
            </label>
          ))}
        </div>
        <p id="availability-days-error" class="hidden mt-3 text-sm text-red-700">Elegí al menos un día de disponibilidad.</p>
      </fieldset>
      <label class="block sm:col-span-2">
        <span class={labelClass}>Horario *</span>
        <select name="availabilityTime" required class={fieldClass}>
          <option value="">Seleccioná un horario</option>
          {timeBands.map((item) => <option value={item}>{item}</option>)}
        </select>
      </label>
    </fieldset>

    <label class="block sm:col-span-2">
      <span class={labelClass}>Mensaje</span>
      <textarea name="workMessage" rows="4" class={fieldClass}></textarea>
    </label>
  </fieldset>

  <p id="form-error" class="hidden text-sm text-red-700 sm:col-span-2" role="alert">
    Revisá los campos marcados con * antes de enviar.
  </p>

  <button type="submit" class="btn-dark min-h-12 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary sm:col-span-2">
    <Icon name="simple-icons:whatsapp" class="h-4 w-4" />
    Enviar por WhatsApp
  </button>
</form>

<div id="form-success" class="hidden rounded-3xl bg-ink p-10 text-cream" role="status" tabindex="-1">
  <p class="eyebrow text-accent">Listo</p>
  <h2 class="mt-4 font-display text-4xl uppercase">¡Gracias por escribirnos!</h2>
  <p class="mt-4 text-cream/70">
    Tu mensaje está preparado. Revisalo y envialo desde WhatsApp. Si no se abrió, <a id="form-fallback" class="text-accent underline" target="_blank" rel="noopener noreferrer" href="#">tocá acá</a>.
  </p>
  <a href="/" class="btn-ghost mt-8">Volver al inicio</a>
</div>

<script>
  import { whatsappUrl } from "../data/site";

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const error = document.getElementById("form-error")!;
  const success = document.getElementById("form-success")!;
  const fallback = document.getElementById("form-fallback") as HTMLAnchorElement;

  const intentInputs = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="intent"]'));
  const driverInputs = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="driver"]'));
  const servicesFieldset = document.getElementById("fieldset-services") as HTMLFieldSetElement;
  const workFieldset = document.getElementById("fieldset-work") as HTMLFieldSetElement;
  const driverDetailsFieldset = document.getElementById("fieldset-driver-details") as HTMLFieldSetElement;

  const parseIntent = (value: string | null | undefined) =>
    value === "services" || value === "work" ? value : undefined;
  const preset = parseIntent(form.dataset.presetIntent);
  const requested = parseIntent(new URLSearchParams(window.location.search).get("intent"));
  let intent = preset ?? requested ?? "services";
  const locked = Boolean(preset) || requested === "services" || form.dataset.hideIntent === "true";
  const intentFieldset = document.getElementById("fieldset-intent") as HTMLFieldSetElement | null;
  if (intentFieldset) {
    intentFieldset.classList.toggle("hidden", locked);
    intentFieldset.disabled = locked;
  }
  intentInputs.forEach((input) => { input.checked = input.value === intent; });

  const controls = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input, select, textarea"));
  const requiredGroups = Array.from(form.querySelectorAll<HTMLFieldSetElement>("[data-required-group]"));
  let submitted = false;

  const validate = (showErrors: boolean) => {
    let valid = true;
    controls.forEach((field) => {
      const invalid = !field.matches(":disabled") && !field.checkValidity();
      valid = valid && !invalid;
      field.setAttribute("aria-invalid", String(showErrors && invalid));
      field.classList.toggle("!border-red-600", showErrors && invalid);
    });
    requiredGroups.forEach((group) => {
      const checkboxes = Array.from(group.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));
      const invalid = checkboxes.some((input) => !input.matches(":disabled")) && !checkboxes.some((input) => input.checked);
      valid = valid && !invalid;
      group.setAttribute("aria-invalid", String(showErrors && invalid));
      checkboxes.forEach((input) => input.setAttribute("aria-invalid", String(showErrors && invalid)));
      document.getElementById(group.getAttribute("aria-describedby")!)?.classList.toggle("hidden", !showErrors || !invalid);
    });
    error.classList.toggle("hidden", !showErrors || valid);
    return valid;
  };

  const applyState = () => {
    if (!locked) intent = parseIntent(intentInputs.find((input) => input.checked)?.value) ?? intent;
    form.dataset.intent = intent;
    servicesFieldset.disabled = intent !== "services";
    servicesFieldset.classList.toggle("hidden", intent !== "services");
    workFieldset.disabled = intent !== "work";
    workFieldset.classList.toggle("hidden", intent !== "work");

    const driver = driverInputs.find((input) => input.checked)?.value;
    const showDriver = intent === "work" && driver === "yes";
    driverDetailsFieldset.disabled = !showDriver;
    driverDetailsFieldset.classList.toggle("hidden", !showDriver);
    submitted = false;
    validate(false);
  };
  applyState();

  intentInputs.forEach((input) => input.addEventListener("change", applyState));
  driverInputs.forEach((input) => input.addEventListener("change", applyState));
  form.addEventListener("input", () => { if (submitted) validate(true); });
  form.addEventListener("change", () => { if (submitted) validate(true); });

  form.addEventListener("submit", (event) => {
    event.preventDefault();

    submitted = true;
    if (!validate(true)) {
      const firstInvalid = controls.find((field) => field.getAttribute("aria-invalid") === "true");
      firstInvalid?.focus();
      firstInvalid?.reportValidity();
      return;
    }

    const data = new FormData(form);
    const value = (key: string) => String(data.get(key) ?? "").trim();
    const shared = [
      `Nombre: ${value("name")}`,
      `Teléfono: ${value("phone")}`,
    ];

    const lines =
      intent === "work"
        ? [
            "Hola FLEXAI, quiero trabajar con FLEXAI.",
            ...shared,
            `Conductor: ${value("driver") === "yes" ? "Sí" : "No"}`,
            ...(value("driver") === "yes"
              ? [
                  `Zona de origen: ${value("originZone")}`,
                  `Zona de interés: ${value("interestZone")}`,
                  `Vehículo: ${value("vehicle")}`,
                  `Tamaño del vehículo: ${value("vehicleSize")}`,
                  `Disponibilidad: ${data.getAll("availabilityDays").join(", ")} · ${value("availabilityTime")}`,
                ]
              : []),
            ...(value("workMessage") ? [`Mensaje: ${value("workMessage")}`] : []),
          ]
        : [
            "Hola FLEXAI, quiero información sobre el servicio de envíos.",
            ...shared,
            `Empresa: ${value("store")}`,
            `Zona de colecta: ${value("locality")}`,
            `Paquetes por día: ${value("volume")}`,
            `Zonas de entrega: ${data.getAll("deliveryZones").join(", ")}`,
            `Tamaño de paquetes: ${value("size")}`,
            ...(value("url") ? [`Link: ${value("url")}`] : []),
            ...(value("message") ? [`Mensaje: ${value("message")}`] : []),
          ];

    const url = whatsappUrl(lines.join("\n"));
    fallback.href = url;
    window.open(url, "_blank", "noopener");

    form.classList.add("hidden");
    success.classList.remove("hidden");
    success.focus();
  });
</script>
