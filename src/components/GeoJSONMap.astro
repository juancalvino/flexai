---
import { ZONE_LIST } from "../data/zones";
---

<div class="grid gap-6 lg:grid-cols-[1fr_380px]">
  <div class="relative overflow-hidden rounded-3xl ring-1 ring-cream/10">
    <div id="coverage-map" class="h-[420px] w-full bg-ink-soft md:h-[600px]" aria-label="Mapa de cobertura AMBA"></div>
    <p id="map-status" class="absolute inset-0 flex items-center justify-center text-cream/50">Cargando mapa…</p>
  </div>

  <aside class="flex flex-col gap-6 rounded-3xl bg-ink-soft p-6 ring-1 ring-cream/10 md:p-8" aria-live="polite">
    <div class="grid grid-cols-2 rounded-full bg-ink p-1" role="group" aria-label="Plan">
      <button type="button" class="plan-btn rounded-full py-2.5 font-display text-sm uppercase tracking-wider" data-plan="standard" aria-pressed="true">Standard</button>
      <button type="button" class="plan-btn rounded-full py-2.5 font-display text-sm uppercase tracking-wider" data-plan="pro" aria-pressed="false">Pro</button>
    </div>

    <div>
      <p class="eyebrow text-cream/40">Zona</p>
      <h2 id="zone-title" class="mt-2 font-display text-4xl uppercase">AMBA</h2>
      <p id="zone-description" class="mt-1 text-cream/60">Tocá una zona del mapa o de la lista para ver la tarifa.</p>
    </div>

    <div id="zone-price-wrap" class="hidden border-y border-cream/10 py-5">
      <p class="eyebrow text-cream/40">Tarifa por paquete</p>
      <p id="zone-price" class="mt-2 font-display text-5xl text-brand-yellow-500"></p>
      <p class="mt-1 text-xs text-cream/40">IVA no incluido</p>
    </div>

    <ul id="zone-localities" class="hidden flex-wrap gap-2"></ul>

    <ul class="mt-auto grid grid-cols-2 gap-2">
      {
        ZONE_LIST.map((zone) => (
          <li>
            <button
              type="button"
              class="zone-btn flex w-full items-center gap-3 rounded-xl border border-cream/10 px-4 py-3 text-left transition-colors hover:border-brand-yellow-500 aria-pressed:border-brand-yellow-500 aria-pressed:bg-cream/5"
              data-zone={zone.id}
              aria-pressed="false"
            >
              <span class="h-3 w-3 shrink-0 rounded-full ring-1 ring-cream/30" style={`background:${zone.color}`} />
              <span class="font-display uppercase">{zone.name}</span>
            </button>
          </li>
        ))
      }
    </ul>

    <a id="zone-cta" href="/contacto" target="_blank" rel="noopener noreferrer" class="btn-primary w-full">Consultar por esta zona</a>
  </aside>
</div>

<style is:global>
  #coverage-map .leaflet-tooltip.zone-tooltip {
    background: #1f1e1d;
    color: #f3f1eb;
    border: 0;
    border-radius: 999px;
    padding: 6px 12px;
    font-family: Kanit, sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: none;
  }

  #coverage-map .leaflet-tooltip.zone-tooltip::before {
    display: none;
  }

  /* Dark basemap from standard OSM tiles. */
  #coverage-map .map-tiles {
    filter: grayscale(1) invert(1) brightness(0.75) contrast(0.9);
  }

  #coverage-map.leaflet-container {
    background: #292727;
    font-family: inherit;
  }

  .plan-btn[aria-pressed="true"] {
    background: #ffcf15;
    color: #1f1e1d;
  }

  .plan-btn[aria-pressed="false"] {
    color: rgb(243 241 235 / 0.6);
  }
</style>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";
  import type { FeatureCollection } from "geojson";
  import { ZONES, formatPrice, type PlanId, type ZoneId } from "../data/zones";
  import { whatsappUrl } from "../data/site";

  const status = document.getElementById("map-status")!;
  const title = document.getElementById("zone-title")!;
  const description = document.getElementById("zone-description")!;
  const priceWrap = document.getElementById("zone-price-wrap")!;
  const price = document.getElementById("zone-price")!;
  const localities = document.getElementById("zone-localities")!;
  const cta = document.getElementById("zone-cta") as HTMLAnchorElement;
  const planButtons = document.querySelectorAll<HTMLButtonElement>(".plan-btn");
  const zoneButtons = document.querySelectorAll<HTMLButtonElement>(".zone-btn");

  let plan: PlanId = "standard";
  let selected: { zone: ZoneId; place: string } | null = null;
  const layersByZone = new Map<ZoneId, L.Path[]>();

  const baseStyle = (zone: ZoneId): L.PathOptions => ({
    fillColor: ZONES[zone].color,
    fillOpacity: 0.55,
    color: "#1f1e1d",
    weight: 1,
  });

  const activeStyle: L.PathOptions = { fillOpacity: 0.9, color: "#ffcf15", weight: 2 };

  function render() {
    planButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset["plan"] === plan)));
    zoneButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset["zone"] === selected?.zone)));

    layersByZone.forEach((layers, zone) =>
      layers.forEach((layer) => layer.setStyle(zone === selected?.zone ? activeStyle : baseStyle(zone))),
    );

    if (!selected) return;
    const zone = ZONES[selected.zone];
    title.textContent = zone.name;
    description.textContent = selected.place === zone.name ? zone.description : `${selected.place} · ${zone.description}`;
    price.textContent = formatPrice(zone.prices[plan]);
    priceWrap.classList.remove("hidden");

    localities.replaceChildren(
      ...zone.localities.map((name) => {
        const item = document.createElement("li");
        item.className = "rounded-full bg-cream/10 px-3 py-1 text-xs text-cream/80";
        item.textContent = name;
        return item;
      }),
    );
    localities.classList.replace("hidden", "flex");

    const place = selected.place === zone.name ? zone.name : `${selected.place} (${zone.name})`;
    cta.href = whatsappUrl(`Hola FLEXAI, quiero información del servicio para ${place}.`);
  }

  function select(zone: ZoneId, place: string) {
    selected = { zone, place };
    render();
  }

  planButtons.forEach((button) =>
    button.addEventListener("click", () => {
      plan = button.dataset["plan"] as PlanId;
      render();
    }),
  );

  zoneButtons.forEach((button) =>
    button.addEventListener("click", () => {
      const zone = button.dataset["zone"] as ZoneId;
      select(zone, ZONES[zone].name);
    }),
  );

  const map = L.map("coverage-map", { scrollWheelZoom: false, zoomControl: true }).setView([-34.62, -58.45], 9);

  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    maxZoom: 14,
    className: "map-tiles",
  }).addTo(map);

  const featureZone = (properties: Record<string, unknown> | null) => ({
    zone: properties?.["zone"] as ZoneId,
    place: String(properties?.["name"] ?? ""),
  });

  fetch("/data/amba.geojson")
    .then((response) => response.json() as Promise<FeatureCollection>)
    .then((data) => {
      const layer = L.geoJSON(data, {
        style: (feature) => baseStyle(featureZone(feature?.properties ?? null).zone),
        onEachFeature: (feature, featureLayer) => {
          const { zone, place } = featureZone(feature.properties);
          const path = featureLayer as L.Path;
          layersByZone.set(zone, [...(layersByZone.get(zone) ?? []), path]);
          path.bindTooltip(`${place} · ${ZONES[zone].name}`, { className: "zone-tooltip", direction: "top", sticky: true });
          path.on("click", () => select(zone, place));
        },
      }).addTo(map);

      map.fitBounds(layer.getBounds(), { padding: [10, 10] });
      status.remove();
    })
    .catch(() => {
      status.textContent = "No pudimos cargar el mapa. Usá la lista de zonas.";
    });
</script>
