---
import { Icon } from "astro-icon/components";
import { ZONE_LIST, PARTIDO_EXCEPTIONS } from "../data/zones";
import { FEATURES } from "../data/features";

// Coverage is public in every variant; commercial data stays out of the map payload.
const mapData = {
  zones: ZONE_LIST.map(({ prices, ...zone }) => zone),
  exceptions: PARTIDO_EXCEPTIONS,
};

const localityOptions = [
  ...new Set(
    ZONE_LIST.flatMap((zone) => [
      ...(zone.id === "CABA" ? ["CABA"] : zone.localities),
      ...(zone.searchAliases ?? []).flatMap((alias) => alias.names),
    ]),
  ),
].sort((a, b) => a.localeCompare(b, "es"));
---

<div class="grid gap-6 lg:grid-cols-[1fr_400px]">
  <div class="relative isolate min-h-[440px] overflow-hidden rounded-3xl ring-1 ring-cream/10 md:min-h-[640px]">
    <div id="coverage-map" data-map={JSON.stringify(mapData)} class="absolute inset-0 bg-ink-soft" aria-label="Mapa de cobertura AMBA"></div>
    <p id="map-status" class="pointer-events-none absolute inset-0 z-[500] flex items-center justify-center text-cream/50">Cargando mapa…</p>

    <button
      id="map-reset"
      type="button"
      class="absolute right-3 top-3 z-[500] flex items-center gap-2 rounded-full bg-ink/90 px-4 py-3 font-display text-xs uppercase tracking-wider text-cream ring-1 ring-cream/15 backdrop-blur transition-colors hover:text-accent"
    >
      <Icon name="bx:expand-alt" class="h-4 w-4" />
      Ver todo
    </button>

    <p id="map-hint" class="pointer-events-none absolute bottom-3 left-3 z-[500] rounded-full bg-ink/80 px-3 py-1.5 text-xs text-cream/60 lg:hidden">
      Usá dos dedos para mover el mapa
    </p>

    <!-- Mobile: selection summary over the map, since the side panel sits below it. -->
    <a
      id="map-summary"
      href="#zone-panel"
      class="absolute inset-x-3 bottom-8 z-[500] hidden items-center justify-between gap-4 rounded-2xl bg-ink/95 px-5 py-4 ring-1 ring-accent/60 backdrop-blur lg:hidden"
    >
      <span>
        <span id="map-summary-place" class="block font-display text-lg uppercase leading-tight"></span>
        <span id="map-summary-zone" class="block text-xs text-cream/50"></span>
      </span>
      <Icon name="bx:chevron-down" class="h-5 w-5 text-cream/60" />
    </a>
  </div>

  <aside id="zone-panel" class="flex scroll-mt-24 flex-col gap-6 rounded-3xl bg-ink-soft p-6 ring-1 ring-cream/10 md:p-8">
    <form id="locality-search" class="relative" role="search">
      <label for="locality-input" class="eyebrow text-cream/40">Buscá tu localidad</label>
      <div class="relative mt-2">
        <div class="relative">
          <Icon name="bx:search" class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-cream/40" />
          <input
            id="locality-input"
            role="combobox"
            aria-controls="locality-options"
            aria-expanded="false"
            aria-autocomplete="list"
            aria-describedby="search-feedback"
            autocomplete="off"
            placeholder="Ej: Quilmes, Pilar, Tigre…"
            class="w-full rounded-full border-cream/15 bg-ink py-3 pl-12 pr-4 text-cream placeholder:text-cream/30 focus:border-accent focus:ring-0"
          />
        </div>
        <ul
          id="locality-options"
          role="listbox"
          aria-label="Localidades"
          data-localities={JSON.stringify(localityOptions)}
          data-lenis-prevent
          hidden
          class="static lg:absolute lg:inset-x-0 lg:top-full z-20 mt-2 max-h-64 touch-pan-y overflow-y-auto overflow-x-hidden overscroll-contain rounded-2xl border border-cream/15 bg-ink p-1.5 text-cream shadow-xl shadow-black/25"
        ></ul>
      </div>
      <p id="search-feedback" class="mt-2 hidden text-sm text-cream/50" role="status"></p>
    </form>

    <div aria-live="polite">
      <p class="eyebrow text-cream/40">Zona</p>
      <h2 id="zone-title" class="mt-2 font-display text-4xl uppercase">AMBA</h2>
      <p id="zone-description" class="mt-1 text-cream/60">
        Tocá el mapa, buscá tu localidad o elegí una zona para conocer la cobertura.
      </p>
      <p id="zone-note" class="mt-3 hidden rounded-xl bg-accent/10 px-4 py-3 text-sm text-accent"></p>
    </div>

    <details id="zone-localities-wrap" class="group hidden" open>
      <summary class="flex cursor-pointer list-none items-center justify-between text-sm text-cream/70 hover:text-cream">
        <span>Localidades incluidas (<span id="zone-localities-count"></span>)</span>
        <Icon name="bx:chevron-down" class="h-5 w-5 transition-transform group-open:rotate-180" />
      </summary>
      <ul id="zone-localities" class="mt-3 flex flex-wrap gap-2"></ul>
    </details>

    <ul class="mt-auto grid grid-cols-2 gap-2" aria-label="Zonas">
      {
        ZONE_LIST.map((zone) => (
          <li>
            <button
              type="button"
              class="zone-btn flex w-full flex-col gap-1 rounded-xl border border-cream/10 px-4 py-3 text-left transition-colors hover:border-accent aria-pressed:border-accent aria-pressed:bg-cream/5"
              data-zone={zone.id}
              aria-pressed="false"
            >
              <span class="flex items-center gap-2">
                <span class="h-3 w-3 shrink-0 rounded-full ring-1 ring-cream/30" style={`background:${zone.color}`} />
                <span class="font-display uppercase">{zone.name}</span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>

    <a id="zone-cta" href={FEATURES.pricing ? "/planes" : "/contacto?intent=services#formulario"} class="btn-primary w-full">Cotizar mis envíos</a>
  </aside>
</div>

<style is:global>
  #coverage-map .leaflet-tooltip.zone-tooltip {
    background: rgb(var(--color-ink));
    color: rgb(var(--color-cream));
    border: 0;
    border-radius: 999px;
    padding: 6px 12px;
    font-family: Kanit, sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: none;
  }

  #coverage-map .leaflet-tooltip.zone-tooltip::before {
    display: none;
  }

  /* Dark blue basemap from standard OSM tiles. */
  #coverage-map .map-tiles {
    filter: grayscale(1) invert(1) brightness(0.62) contrast(0.95) sepia(1) hue-rotate(175deg) saturate(1.6);
  }

  @media (pointer: coarse) {
    #coverage-map .leaflet-bar a {
      width: 44px;
      height: 44px;
      line-height: 44px;
      font-size: 22px;
    }
  }

  /* Browsers draw a focus ring around the SVG path's bounding box on tap: hide it on the map. */
  #coverage-map {
    -webkit-tap-highlight-color: transparent;
  }

  #coverage-map path.leaflet-interactive:focus {
    outline: none;
  }

  /* Place names drawn above the colored zones. The marker is a zero-size anchor. */
  #coverage-map .map-label span {
    position: absolute;
    transform: translate(-50%, -50%);
    font-family: Kanit, sans-serif;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgb(var(--color-cream));
    text-shadow:
      0 0 3px rgb(var(--color-ink)),
      0 0 6px rgb(var(--color-ink));
    pointer-events: none;
  }

  #coverage-map .map-label--zone span {
    font-size: 15px;
    font-weight: 600;
  }

  #coverage-map.leaflet-container {
    background: rgb(var(--color-ink-soft));
    font-family: inherit;
  }

  #coverage-map .leaflet-bar a {
    background: rgb(var(--color-ink));
    color: rgb(var(--color-cream));
    border-color: rgb(var(--color-cream) / 0.15);
  }

  #coverage-map .leaflet-control-attribution {
    background: rgb(var(--color-ink) / 0.8);
    color: rgb(var(--color-cream) / 0.5);
  }

  #coverage-map .leaflet-control-attribution a {
    color: rgb(var(--color-cream) / 0.7);
  }
</style>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";
  import type { FeatureCollection } from "geojson";
  import type { Zone, ZoneId } from "../data/zones";

  // Leaflet writes colors as SVG attributes, which can't use var(): resolve theme tokens once.
  const rootStyle = getComputedStyle(document.documentElement);
  const themeColor = (token: string) =>
    `rgb(${rootStyle.getPropertyValue(`--color-${token}`).trim().split(/\s+/).join(", ")})`;

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  type MapZone = Omit<Zone, "prices">;
  const { zones: ZONE_LIST, exceptions: PARTIDO_EXCEPTIONS } = JSON.parse($("coverage-map").dataset["map"]!) as {
    zones: MapZone[];
    exceptions: Record<string, string[]>;
  };
  const ZONES = Object.fromEntries(ZONE_LIST.map((zone) => [zone.id, zone])) as Record<ZoneId, MapZone>;

  const status = $("map-status");
  const title = $("zone-title");
  const description = $("zone-description");
  const localitiesWrap = $("zone-localities-wrap");
  const localities = $("zone-localities");
  const localitiesCount = $("zone-localities-count");
  const searchForm = $<HTMLFormElement>("locality-search");
  const searchInput = $<HTMLInputElement>("locality-input");
  const searchFeedback = $("search-feedback");
  const searchOptions = $("locality-options");
  const suggestionNames = JSON.parse(searchOptions.dataset["localities"]!) as string[];
  let activeSuggestion = -1;
  let visibleSuggestions: string[] = [];
  let committedSearchValue: string | null = null;
  const note = $("zone-note");
  const summary = $("map-summary");
  const summaryPlace = $("map-summary-place");
  const summaryZone = $("map-summary-zone");
  const hint = $("map-hint");
  const zoneButtons = document.querySelectorAll<HTMLButtonElement>(".zone-btn");

  type Selection = { zone: ZoneId; place: string; within?: string };

  let selected: Selection | null = null;
  let hovered: ZoneId | null = null;
  let overview: { center: L.LatLng; zoom: number } | null = null;
  const layersByZone = new Map<ZoneId, L.Polygon[]>();
  const layersByPlace = new Map<string, L.Polygon>();

  const normalize = (text: string) =>
    text.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").trim();

  // Localities listed per zone (includes places without their own polygon, e.g. Nordelta).
  const localityZone = new Map<string, Selection>(
    ZONE_LIST.flatMap((zone) => [
      ...[zone.name, ...zone.localities].map((name) => [normalize(name), { zone: zone.id, place: name }] as const),
      ...(zone.searchAliases ?? []).flatMap(({ within, names }) =>
        names.map((name) => [normalize(name), { zone: zone.id, place: name, ...(within ? { within } : {}) }] as const),
      ),
    ]),
  );

  function styleFor(zone: ZoneId): L.PathOptions {
    const isSelected = zone === selected?.zone;
    const isHovered = zone === hovered;
    return {
      fillColor: themeColor(ZONES[zone].colorToken),
      fillOpacity: isSelected ? 0.85 : isHovered ? 0.8 : selected ? 0.3 : 0.62,
      color: isSelected ? themeColor("highlight") : themeColor("ink"),
      weight: isSelected ? 1.5 : 1,
    };
  }

  function paintMap() {
    layersByZone.forEach((layers, zone) => layers.forEach((layer) => layer.setStyle(styleFor(zone))));
    const placeLayer = selected && layersByPlace.get(normalize(selected.within ?? selected.place));
    placeLayer?.setStyle({ weight: 3.5, color: themeColor("highlight"), fillOpacity: 0.95 }).bringToFront();
  }

  function render() {
    zoneButtons.forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset["zone"] === selected?.zone));
    });
    paintMap();

    summary.classList.toggle("hidden", !selected);
    summary.classList.toggle("flex", Boolean(selected));
    hint.classList.toggle("hidden", Boolean(selected));

    const exceptions = selected && !selected.within ? (PARTIDO_EXCEPTIONS[selected.place] ?? []) : [];
    const notes = exceptions.flatMap((name) => {
      const exception = localityZone.get(normalize(name));
      return exception && exception.zone !== selected?.zone
        ? [`${name} pertenece a la zona ${ZONES[exception.zone].name}.`]
        : [];
    });
    note.textContent = notes.join(" ");
    note.classList.toggle("hidden", notes.length === 0);

    if (!selected) return;

    const zone = ZONES[selected.zone];
    const isZoneOnly = selected.place === zone.name;
    title.textContent = isZoneOnly ? zone.name : selected.place;
    const area = selected.within ? `${selected.within} · ${zone.name}` : `${zone.name} · ${zone.description}`;
    description.textContent = isZoneOnly ? zone.description : area;

    summaryPlace.textContent = title.textContent;
    summaryZone.textContent = zone.name;

    localitiesCount.textContent = String(zone.localities.length);
    localities.replaceChildren(
      ...zone.localities.map((name) => {
        const item = document.createElement("li");
        item.className = "rounded-full bg-cream/10 px-3 py-1 text-xs text-cream/80";
        item.textContent = name;
        return item;
      }),
    );
    localitiesWrap.classList.remove("hidden");
  }

  function focusSelection() {
    if (!selected) return;
    const placeLayer = layersByPlace.get(normalize(selected.within ?? selected.place));
    const layers = placeLayer ? [placeLayer] : (layersByZone.get(selected.zone) ?? []);
    if (!layers.length) return;
    const bounds = L.featureGroup(layers).getBounds();
    map.flyToBounds(bounds, { padding: [40, 40], maxZoom: 12, duration: 0.8 });
  }

  function select(selection: Selection, { fly = true } = {}) {
    selected = selection;
    render();
    if (fly) focusSelection();
  }

  zoneButtons.forEach((button) =>
    button.addEventListener("click", () => {
      const zone = button.dataset["zone"] as ZoneId;
      select({ zone, place: ZONES[zone].name });
    }),
  );

  function clearSearchFeedback() {
    searchFeedback.classList.add("hidden");
    searchFeedback.textContent = "";
  }

  function closeSuggestions() {
    searchOptions.hidden = true;
    searchInput.setAttribute("aria-expanded", "false");
    searchInput.removeAttribute("aria-activedescendant");
    activeSuggestion = -1;
    visibleSuggestions = [];
    searchOptions.replaceChildren();
  }

  function chooseSuggestion(name: string) {
    searchInput.value = name;
    searchLocality();
  }

  function showSuggestions() {
    closeSuggestions();
    const query = normalize(searchInput.value);
    if (!query) return;
    // Only the popup is capped: the resolver below always searches the full map.
    visibleSuggestions = suggestionNames.filter((name) => normalize(name).includes(query)).slice(0, 8);
    searchOptions.replaceChildren(...visibleSuggestions.map((name, index) => {
      const option = document.createElement("li");
      option.id = `locality-option-${index}`;
      option.setAttribute("role", "option");
      option.setAttribute("aria-selected", "false");
      option.className = "flex min-h-[44px] cursor-pointer items-center whitespace-normal break-words rounded-xl px-3 py-2 text-sm leading-snug transition-colors hover:bg-accent/10 hover:text-accent aria-selected:bg-accent/15 aria-selected:text-accent";
      option.textContent = name;
      // Keep input focus until click; scrolling/cancelled touch gestures must not select.
      option.addEventListener("pointerdown", (event) => event.preventDefault());
      option.addEventListener("click", () => chooseSuggestion(name));
      return option;
    }));
    searchOptions.hidden = visibleSuggestions.length === 0;
    searchInput.setAttribute("aria-expanded", String(!searchOptions.hidden));
  }

  function searchLocality(event?: Event) {
    closeSuggestions();
    // A later native change must not repeat a selection already committed by click/Enter.
    if (event?.type === "change" && searchInput.value === committedSearchValue) return;
    const query = normalize(searchInput.value);
    if (!query) return;
    const partial = [...localityZone.entries()].filter(([name]) => name.includes(query)).map(([, value]) => value);
    const zonesFound = new Set(partial.map((item) => item.zone));

    // e.g. "La Matanza" is split between GBA 1 and GBA 2: ask for the locality instead of guessing.
    if (!localityZone.has(query) && zonesFound.size > 1) {
      const options = partial.slice(0, 4).map((item) => `${item.place} (${ZONES[item.zone].name})`);
      searchFeedback.textContent = `Hay más de una zona: ${options.join(", ")}. Escribí tu localidad.`;
      searchFeedback.classList.remove("hidden");
      return;
    }

    const match = localityZone.get(query) ?? partial[0];

    if (!match) {
      searchFeedback.textContent = "No encontramos esa localidad. Escribinos y te confirmamos si llegamos.";
      searchFeedback.classList.remove("hidden");
      return;
    }

    clearSearchFeedback();
    searchInput.value = match.place;
    committedSearchValue = match.place;
    select(match);
  }

  searchForm.addEventListener("submit", (event) => {
    event.preventDefault();
    searchLocality();
  });

  // Preserve free-text search when the browser commits an edit on blur.
  searchInput.addEventListener("change", searchLocality);
  searchInput.addEventListener("input", () => {
    committedSearchValue = null;
    clearSearchFeedback();
    showSuggestions();
  });
  searchInput.addEventListener("focus", showSuggestions);
  searchInput.addEventListener("blur", closeSuggestions);
  document.addEventListener("pointerdown", (event) => {
    if (!searchForm.contains(event.target as Node)) closeSuggestions();
  });
  searchInput.addEventListener("keydown", (event) => {
    if (event.isComposing) return;
    if (event.key === "Escape" || event.key === "Tab") {
      if (event.key === "Escape" && !searchOptions.hidden) event.preventDefault();
      closeSuggestions();
      return;
    }
    if (event.key === "Enter" && activeSuggestion >= 0) {
      event.preventDefault();
      chooseSuggestion(visibleSuggestions[activeSuggestion]!);
      return;
    }
    if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
    if (searchOptions.hidden) showSuggestions();
    const count = visibleSuggestions.length;
    if (!count) return;
    event.preventDefault();
    activeSuggestion = activeSuggestion < 0
      ? (event.key === "ArrowDown" ? 0 : count - 1)
      : (activeSuggestion + (event.key === "ArrowDown" ? 1 : -1) + count) % count;
    Array.from(searchOptions.children).forEach((option, index) => {
      option.setAttribute("aria-selected", String(index === activeSuggestion));
      if (index === activeSuggestion) {
        searchInput.setAttribute("aria-activedescendant", option.id);
        option.scrollIntoView({ block: "nearest" });
      }
    });
  });

  const isTouch = window.matchMedia("(pointer: coarse)").matches;

  const map = L.map("coverage-map", {
    scrollWheelZoom: false,
    dragging: !isTouch,
    zoomSnap: 0.25,
    minZoom: 8,
    maxZoom: 13,
  }).setView([-34.62, -58.45], 9);

  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    className: "map-tiles",
  }).addTo(map);

  // Labels live in their own pane: map → zones → labels → hover tooltip.
  map.createPane("labels");
  const labelsPane = map.getPane("labels")!;
  labelsPane.style.zIndex = "450"; // above zones (overlayPane 400), below tooltips (650)
  labelsPane.style.pointerEvents = "none";

  // Labels in priority order (bigger areas first); overlapping ones are hidden.
  const labels: L.Marker[] = [];

  const addLabel = (position: L.LatLng, text: string, className = "") => {
    const marker = L.marker(position, {
      pane: "labels",
      interactive: false,
      keyboard: false,
      icon: L.divIcon({ className: `map-label ${className}`, html: `<span>${text}</span>`, iconSize: [0, 0] }),
    }).addTo(map);
    labels.push(marker);
  };

  function resolveLabelCollisions() {
    const placed: DOMRect[] = [];
    labels.forEach((marker) => {
      const element = marker.getElement();
      const text = element?.firstElementChild;
      if (!element || !text) return;
      element.style.visibility = "visible";
      const box = text.getBoundingClientRect();
      const overlaps = placed.some(
        (other) => box.left < other.right + 4 && box.right > other.left - 4 && box.top < other.bottom + 2 && box.bottom > other.top - 2,
      );
      if (overlaps) element.style.visibility = "hidden";
      else placed.push(box);
    });
  }

  map.on("zoomend moveend", resolveLabelCollisions);

  // The map fills its grid cell, whose height follows the side panel.
  new ResizeObserver(() => map.invalidateSize()).observe($("coverage-map"));

  // Enable wheel zoom only after the user interacts with the map, so page scroll is never hijacked.
  map.once("focus click", () => map.scrollWheelZoom.enable());

  $("map-reset").addEventListener("click", () => {
    selected = null;
    title.textContent = "AMBA";
    description.textContent = "Tocá el mapa, buscá tu localidad o elegí una zona para conocer la cobertura.";
    localitiesWrap.classList.add("hidden");
    searchInput.value = "";
    committedSearchValue = null;
    closeSuggestions();
    clearSearchFeedback();
    render();
    if (overview) map.flyTo(overview.center, overview.zoom, { duration: 0.8 });
  });

  fetch("/data/amba.geojson")
    .then((response) => response.json() as Promise<FeatureCollection>)
    .then((data) => {
      const layer = L.geoJSON(data, {
        style: (feature) => styleFor(feature?.properties?.["zone"] as ZoneId),
        onEachFeature: (feature, featureLayer) => {
          const zone = feature.properties?.["zone"] as ZoneId;
          const place = String(feature.properties?.["name"] ?? "");
          const polygon = featureLayer as L.Polygon;

          layersByZone.set(zone, [...(layersByZone.get(zone) ?? []), polygon]);
          if (zone !== "CABA") layersByPlace.set(normalize(place), polygon);

          polygon.bindTooltip(`${place} · ${ZONES[zone].name}`, { className: "zone-tooltip", direction: "top", sticky: true });
          polygon.on({
            mouseover: () => {
              hovered = zone;
              paintMap();
            },
            mouseout: () => {
              hovered = null;
              paintMap();
            },
            click: () => select({ zone, place: zone === "CABA" ? "CABA" : place }, { fly: false }),
          });
        },
      }).addTo(map);

      const caba = layersByZone.get("CABA");
      if (caba?.length) addLabel(L.featureGroup(caba).getBounds().getCenter(), "CABA", "map-label--zone");

      const area = (polygon: L.Polygon) => {
        const bounds = polygon.getBounds();
        return (bounds.getEast() - bounds.getWest()) * (bounds.getNorth() - bounds.getSouth());
      };
      [...layersByPlace.values()]
        .sort((a, b) => area(b) - area(a))
        .forEach((polygon) => addLabel(polygon.getCenter(), String(polygon.feature?.properties?.["name"] ?? "")));

      map.invalidateSize();
      // Fit all zones, then zoom one level closer around the inner zones so the core AMBA reads larger.
      const innerZones: ZoneId[] = ["CABA", "GBA1", "GBA2"];
      const inner = L.featureGroup(innerZones.flatMap((zone) => layersByZone.get(zone) ?? [])).getBounds();
      overview = { center: inner.getCenter(), zoom: map.getBoundsZoom(layer.getBounds(), false, L.point(16, 16)) + 1 };
      map.setView(overview.center, overview.zoom);
      resolveLabelCollisions();
      status.remove();
      render();
    })
    .catch(() => {
      status.textContent = "No pudimos cargar el mapa. Usá el buscador o la lista de zonas.";
    });

  render();
</script>
