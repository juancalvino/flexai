---
import { Icon } from "astro-icon/components";
import Container from "./container.astro";
import Logo from "./ui/Logo.astro";
import { NAVIGATION, SITE, SOCIAL_LINKS, whatsappUrl, DEFAULT_WHATSAPP_MESSAGE } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-ink pt-24 text-cream">
  <Container>
    <div class="grid gap-16 lg:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <p class="eyebrow mb-6 text-brand-yellow-500">¿Arrancamos?</p>
        <a
          href={whatsappUrl(DEFAULT_WHATSAPP_MESSAGE)}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-4 font-display text-4xl uppercase leading-none md:text-6xl"
        >
          Hablanos
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-yellow-500 text-ink transition-transform duration-500 ease-out-expo group-hover:rotate-45 md:h-16 md:w-16">
            <Icon name="bx:up-arrow-alt" class="h-6 w-6 rotate-45 md:h-8 md:w-8" />
          </span>
        </a>
      </div>

      <nav aria-label="Pie de página">
        <p class="eyebrow mb-6 text-cream/40">Navegación</p>
        <ul class="space-y-1">
          {
            NAVIGATION.map((item) => (
              <li>
                <a href={item.path} class="inline-block py-2 text-cream/80 transition-colors hover:text-brand-yellow-500">
                  {item.title}
                </a>
              </li>
            ))
          }
          <li>
            <a href={SITE.lightDataUrl} target="_blank" rel="noopener noreferrer" class="inline-block py-2 text-cream/80 transition-colors hover:text-brand-yellow-500">
              Sistema LightData
            </a>
          </li>
        </ul>
      </nav>

      <div>
        <p class="eyebrow mb-6 text-cream/40">Contacto</p>
        <ul class="space-y-1 text-cream/80">
          <li>
            <a href={SITE.phoneHref} class="inline-block py-2 transition-colors hover:text-brand-yellow-500">{SITE.phoneDisplay}</a>
          </li>
          <li>
            <a href={`mailto:${SITE.email}`} class="inline-block break-all py-2 transition-colors hover:text-brand-yellow-500">{SITE.email}</a>
          </li>
          <li class="py-2">Lunes a sábado · AMBA, Argentina</li>
        </ul>
        <div class="mt-8 flex gap-3">
          {
            SOCIAL_LINKS.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.name}
                class="flex h-11 w-11 items-center justify-center rounded-full border border-cream/20 transition-colors hover:border-brand-yellow-500 hover:bg-brand-yellow-500 hover:text-ink"
              >
                <Icon name={social.icon} class="h-5 w-5" />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mt-20 flex flex-col gap-4 border-t border-cream/10 py-8 text-sm text-cream/40 md:flex-row md:items-center md:justify-between">
      <p>© {year} {SITE.fullName}. Todos los derechos reservados.</p>
      <p>Cada paquete, a tiempo.</p>
    </div>
  </Container>

  <div class="pointer-events-none select-none px-3 pb-2" aria-hidden="true">
    <Logo class="h-auto w-full text-cream/[0.06]" />
  </div>
</footer>
