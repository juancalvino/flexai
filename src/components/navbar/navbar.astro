---
import { Icon } from "astro-icon/components";
import Container from "../container.astro";
import Logo from "../ui/Logo.astro";
import { NAVIGATION, SITE, SOCIAL_LINKS } from "../../data/site";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (path: string) => (path === "/" ? currentPath === "/" : currentPath.startsWith(path));
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 text-cream transition-[background-color,backdrop-filter] duration-500">
  <Container class="flex h-20 items-center justify-between gap-6">
    <a href="/" class="relative z-[60] block w-28 py-3 md:w-32" aria-label="FLEXAI, ir al inicio">
      <Logo class="h-auto w-full text-cream" accent="rgb(var(--color-accent))" />
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-1 rounded-full border border-cream/15 bg-ink/30 p-1 backdrop-blur-md">
        {
          NAVIGATION.map((item) => (
            <li>
              <a
                href={item.path}
                aria-current={isActive(item.path) ? "page" : undefined}
                class:list={[
                  "block rounded-full px-4 py-2 font-display text-sm uppercase tracking-wider transition-colors duration-300",
                  isActive(item.path) ? "bg-cream text-ink" : "text-cream/80 hover:text-accent",
                ]}
              >
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a href={SITE.trackingUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost !px-5 !py-2.5 text-cream">
        Login
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="relative z-[60] flex h-11 w-11 items-center justify-center rounded-full border border-cream/20 lg:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Abrir menú"
    >
      <span class="menu-icon" aria-hidden="true"></span>
    </button>
  </Container>

  <div
    id="mobile-menu"
    class="fixed inset-0 z-50 overflow-y-auto overscroll-contain bg-ink opacity-0 transition-opacity duration-500 [visibility:hidden] data-[open]:opacity-100 data-[open]:[visibility:visible] lg:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Menú"
    data-lenis-prevent
  >
    <div class="menu-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <Container class="relative flex min-h-full flex-col gap-10 pb-[calc(2rem+env(safe-area-inset-bottom))] pt-24">
      <nav aria-label="Móvil">
        <ul class="border-t border-cream/10">
          {
            NAVIGATION.map((item, index) => (
              <li class="menu-item overflow-hidden border-b border-cream/10" style={`--i:${index}`}>
                <a
                  href={item.path}
                  aria-current={isActive(item.path) ? "page" : undefined}
                  class:list={[
                    "group flex items-center justify-between gap-4 py-4 font-display text-[clamp(1.75rem,min(9vw,6.5svh),3rem)] uppercase leading-none transition-colors",
                    isActive(item.path) ? "text-accent" : "text-cream hover:text-accent",
                  ]}
                >
                  <span class="flex items-baseline gap-4">
                    <span class="w-6 font-sans text-xs tabular-nums text-cream/35">0{index + 1}</span>
                    {item.title}
                  </span>
                  {
                    isActive(item.path) ? (
                      <span class="eyebrow text-[10px] text-accent">Estás acá</span>
                    ) : (
                      <Icon name="bx:right-arrow-alt" class="h-6 w-6 shrink-0 text-cream/30 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-accent" />
                    )
                  }
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="menu-footer mt-auto flex flex-col gap-8">
        <div>
          <a href={SITE.trackingUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost w-full text-cream">
            Login
          </a>
        </div>

        <div class="flex flex-wrap items-end justify-between gap-6 border-t border-cream/10 pt-6 text-sm">
          <dl class="grid gap-3">
            <div>
              <dt class="eyebrow text-[10px] text-cream/40">Teléfono</dt>
              <dd><a href={SITE.phoneHref} class="inline-block py-1 text-cream/80 hover:text-accent">{SITE.phoneDisplay}</a></dd>
            </div>
            <div>
              <dt class="eyebrow text-[10px] text-cream/40">Email</dt>
              <dd><a href={`mailto:${SITE.email}`} class="inline-block break-all py-1 text-cream/80 hover:text-accent">{SITE.email}</a></dd>
            </div>
            <div>
              <dt class="eyebrow text-[10px] text-cream/40">Horario</dt>
              <dd class="py-1 text-cream/80">Lunes a sábado · AMBA</dd>
            </div>
          </dl>
          <div class="flex gap-3">
            {
              SOCIAL_LINKS.map((social) => (
                <a
                  href={social.href}
                  target={social.href.startsWith("/") ? undefined : "_blank"}
                  rel={social.href.startsWith("/") ? undefined : "noopener noreferrer"}
                  aria-label={social.name}
                  class="flex h-11 w-11 items-center justify-center rounded-full border border-cream/20 text-cream transition-colors hover:border-accent hover:bg-accent hover:text-accent-contrast"
                >
                  <Icon name={social.icon} class="h-5 w-5" />
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </Container>
  </div>
</header>

<style>
  #site-header[data-scrolled] {
    background-color: rgb(var(--color-ink) / 0.85);
    backdrop-filter: blur(12px);
  }

  .menu-icon,
  .menu-icon::before {
    display: block;
    width: 18px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu-icon {
    position: relative;
    transform: translateY(-3px);
  }

  .menu-icon::before {
    content: "";
    position: absolute;
    top: 6px;
  }

  [aria-expanded="true"] .menu-icon {
    transform: translateY(0) rotate(45deg);
  }

  [aria-expanded="true"] .menu-icon::before {
    transform: translateY(-6px) rotate(-90deg);
  }

  .menu-glow {
    background: radial-gradient(60% 40% at 100% 100%, rgb(var(--color-accent) / 0.12), transparent 70%);
  }

  .menu-item > a {
    transform: translateY(100%);
    transition:
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.3s ease;
    transition-delay: calc(var(--i) * 50ms + 80ms), 0s;
  }

  .menu-footer {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.6s ease,
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0.35s;
  }

  #mobile-menu[data-open] .menu-item > a,
  #mobile-menu[data-open] .menu-footer {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const header = document.getElementById("site-header")!;
  const toggle = document.getElementById("menu-toggle")!;
  const menu = document.getElementById("mobile-menu")!;

  const onScroll = () => header.toggleAttribute("data-scrolled", window.scrollY > 40);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const focusables = () => [toggle, ...menu.querySelectorAll<HTMLElement>("a")];

  function setOpen(open: boolean) {
    menu.toggleAttribute("data-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    document.documentElement.style.overflow = open ? "hidden" : "";
    // Pause the smooth-scroll engine (scripts/motion.ts) so the page behind doesn't move.
    document.dispatchEvent(new CustomEvent(open ? "scroll:lock" : "scroll:unlock"));
    if (open) menu.querySelector<HTMLElement>("a")?.focus();
  }

  toggle.addEventListener("click", () => setOpen(!menu.hasAttribute("data-open")));

  // Links to the current page don't navigate, so close the menu instead.
  menu.querySelectorAll<HTMLAnchorElement>('a[aria-current="page"]').forEach((link) =>
    link.addEventListener("click", (event) => {
      event.preventDefault();
      setOpen(false);
    }),
  );

  document.addEventListener("keydown", (event) => {
    if (!menu.hasAttribute("data-open")) return;

    if (event.key === "Escape") {
      setOpen(false);
      toggle.focus();
      return;
    }

    if (event.key === "Tab") {
      const items = focusables();
      const first = items[0]!;
      const last = items[items.length - 1]!;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }
  });

  window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
    if (event.matches) setOpen(false);
  });
</script>
