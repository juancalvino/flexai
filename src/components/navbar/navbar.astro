---
import Container from "../container.astro";
import Logo from "../ui/Logo.astro";
import { NAVIGATION, SITE, whatsappUrl, DEFAULT_WHATSAPP_MESSAGE } from "../../data/site";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (path: string) => (path === "/" ? currentPath === "/" : currentPath.startsWith(path));
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 text-cream transition-[background-color,backdrop-filter] duration-500">
  <Container class="flex h-20 items-center justify-between gap-6">
    <a href="/" class="relative z-[60] block w-28 py-3 md:w-32" aria-label="FLEXAI, ir al inicio">
      <Logo class="h-auto w-full text-cream" accent="#FFCF15" />
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-1 rounded-full border border-cream/15 bg-ink/30 p-1 backdrop-blur-md">
        {
          NAVIGATION.map((item) => (
            <li>
              <a
                href={item.path}
                aria-current={isActive(item.path) ? "page" : undefined}
                class:list={[
                  "block rounded-full px-4 py-2 font-display text-sm uppercase tracking-wider transition-colors duration-300",
                  isActive(item.path) ? "bg-cream text-ink" : "text-cream/80 hover:text-brand-yellow-500",
                ]}
              >
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a href={SITE.lightDataUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost !px-5 !py-2.5 text-cream">
        LightData
      </a>
      <a href={whatsappUrl(DEFAULT_WHATSAPP_MESSAGE)} target="_blank" rel="noopener noreferrer" class="btn-primary !px-5 !py-2.5">
        Hablanos
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="relative z-[60] flex h-11 w-11 items-center justify-center rounded-full border border-cream/20 lg:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Abrir menú"
    >
      <span class="menu-icon" aria-hidden="true"></span>
    </button>
  </Container>

  <div
    id="mobile-menu"
    class="fixed inset-0 z-50 flex flex-col bg-ink px-5 pb-10 pt-28 opacity-0 transition-opacity duration-500 [visibility:hidden] data-[open]:opacity-100 data-[open]:[visibility:visible] lg:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Menú"
  >
    <nav aria-label="Móvil" class="flex-1">
      <ul class="flex flex-col gap-2">
        {
          NAVIGATION.map((item, index) => (
            <li class="overflow-hidden">
              <a
                href={item.path}
                aria-current={isActive(item.path) ? "page" : undefined}
                class:list={[
                  "mobile-link flex items-baseline gap-4 font-display text-5xl uppercase",
                  isActive(item.path) ? "text-brand-yellow-500" : "text-cream",
                ]}
                style={`--i:${index}`}
              >
                <span class="font-sans text-xs text-cream/40">0{index + 1}</span>
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="flex flex-col gap-3">
      <a href={whatsappUrl(DEFAULT_WHATSAPP_MESSAGE)} target="_blank" rel="noopener noreferrer" class="btn-primary w-full">
        Hablanos por WhatsApp
      </a>
      <a href={SITE.lightDataUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost w-full text-cream">
        Ingresar a LightData
      </a>
    </div>
  </div>
</header>

<style>
  #site-header[data-scrolled] {
    background-color: rgb(31 30 29 / 0.85);
    backdrop-filter: blur(12px);
  }

  .menu-icon,
  .menu-icon::before {
    display: block;
    width: 18px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu-icon {
    position: relative;
    transform: translateY(-3px);
  }

  .menu-icon::before {
    content: "";
    position: absolute;
    top: 6px;
  }

  [aria-expanded="true"] .menu-icon {
    transform: translateY(0) rotate(45deg);
  }

  [aria-expanded="true"] .menu-icon::before {
    transform: translateY(-6px) rotate(-90deg);
  }

  .mobile-link {
    transform: translateY(100%);
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--i) * 60ms + 100ms);
  }

  #mobile-menu[data-open] .mobile-link {
    transform: translateY(0);
  }
</style>

<script>
  const header = document.getElementById("site-header")!;
  const toggle = document.getElementById("menu-toggle")!;
  const menu = document.getElementById("mobile-menu")!;

  const onScroll = () => header.toggleAttribute("data-scrolled", window.scrollY > 40);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const focusables = () => [toggle, ...menu.querySelectorAll<HTMLElement>("a")];

  function setOpen(open: boolean) {
    menu.toggleAttribute("data-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    document.documentElement.style.overflow = open ? "hidden" : "";
    if (open) menu.querySelector<HTMLElement>("a")?.focus();
  }

  toggle.addEventListener("click", () => setOpen(!menu.hasAttribute("data-open")));

  document.addEventListener("keydown", (event) => {
    if (!menu.hasAttribute("data-open")) return;

    if (event.key === "Escape") {
      setOpen(false);
      toggle.focus();
      return;
    }

    if (event.key === "Tab") {
      const items = focusables();
      const first = items[0]!;
      const last = items[items.length - 1]!;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }
  });

  window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
    if (event.matches) setOpen(false);
  });
</script>
