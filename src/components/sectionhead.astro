---
// Section heading: eyebrow + large title + optional description.
import Lines from "./ui/Lines.astro";

interface Props {
  eyebrow?: string;
  title: string[];
  tag?: "h1" | "h2";
  tone?: "light" | "dark";
  accent?: number | undefined;
  class?: string;
}

const { eyebrow, title, tag = "h2", tone = "light", accent, class: className } = Astro.props;
---

<div class:list={["max-w-4xl", className]}>
  {
    eyebrow && (
      <p
        class:list={["eyebrow mb-6", tone === "dark" ? "text-brand-yellow-500" : "text-ink/60"]}
        data-reveal="fade"
      >
        {eyebrow}
      </p>
    )
  }
  <Lines tag={tag} lines={title} accent={accent} class="text-display-sm uppercase" />
  {
    Astro.slots.has("default") && (
      <div
        class:list={["mt-8 max-w-2xl text-lg leading-relaxed", tone === "dark" ? "text-cream/70" : "text-ink/70"]}
        data-reveal="up"
        data-delay="0.2"
      >
        <slot />
      </div>
    )
  }
</div>
