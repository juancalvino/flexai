---
import Container from "../container.astro";
import Lines from "../ui/Lines.astro";
import { whatsappUrl, DEFAULT_WHATSAPP_MESSAGE } from "../../data/site";
---

<section class="relative overflow-hidden bg-brand-yellow-500 py-24 text-ink md:py-36">
  <Container class="flex flex-col gap-12 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="eyebrow mb-6 text-ink/60" data-reveal="fade">Empezá hoy</p>
      <Lines lines={["Tus ventas,", "nuestra ruta."]} class="text-display-md uppercase" />
    </div>
    <div class="flex flex-col gap-3 sm:flex-row" data-reveal="up" data-delay="0.2">
      <a href={whatsappUrl(DEFAULT_WHATSAPP_MESSAGE)} target="_blank" rel="noopener noreferrer" class="btn-dark">
        Hablanos por WhatsApp
      </a>
      <a href="/contacto" class="btn border border-ink hover:bg-ink hover:text-brand-yellow-500">Dejanos tus datos</a>
    </div>
  </Container>
</section>
