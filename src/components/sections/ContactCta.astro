---
import Container from "../container.astro";
import Lines from "../ui/Lines.astro";
---

<section class="relative overflow-hidden bg-accent py-24 text-accent-contrast md:py-36">
  <Container class="flex flex-col gap-12 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="eyebrow mb-6 text-accent-contrast/60" data-reveal="fade">Empezá hoy</p>
      <Lines lines={["Tus ventas,", "nuestra ruta."]} class="text-display-md uppercase" />
    </div>
    <div class="flex flex-col gap-3 sm:flex-row" data-reveal="up" data-delay="0.2">
      <a href="/contacto?intent=services#formulario" class="btn-dark md:px-8 md:py-4 md:text-base">
        Hablanos por WhatsApp
      </a>
      <a href="/contacto?intent=services#formulario" class="btn border border-accent-contrast hover:bg-accent-contrast hover:text-accent md:px-8 md:py-4 md:text-base">Dejanos tus datos</a>
    </div>
  </Container>
</section>
