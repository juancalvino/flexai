---
import Container from "../container.astro";
import Lines from "../ui/Lines.astro";
import ImageSlot from "../ui/ImageSlot.astro";
import SameDayTruck from "../ui/SameDayTruck.astro";
import heroImage from "../../images/hero-night-ride.png";
import { FEATURES } from "../../data/features";
---

<section class="relative flex min-h-svh flex-col overflow-hidden bg-ink text-cream">
  <div class="absolute inset-0" data-reveal="clip">
    <ImageSlot
      src={heroImage}
      loading="eager"
      prompt="fotografía cinematográfica nocturna de una avenida de Buenos Aires con estelas de luces de tránsito y un repartidor en moto en primer plano, desenfoque de movimiento, tonos oscuros con acentos amarillos, formato 16:9 horizontal"
      alt="Repartidor de FLEXAI en moto por una avenida de Buenos Aires"
      class="h-[115%] w-full pt-20"
      data-parallax="0.12"
    />
    <div class="absolute inset-0 bg-linear-to-t from-ink via-ink/75 to-ink/55"></div>
    <div class="absolute inset-0 bg-linear-to-r from-ink/70 via-ink/30 to-transparent"></div>
  </div>

  <Container class="relative flex flex-1 flex-col justify-center pb-16 pt-28 sm:justify-end sm:pt-32 md:pb-20">
    <div class="mb-6 flex flex-wrap gap-3 sm:mb-10" data-reveal="fade" data-delay="0.4">
      <span class="inline-flex items-center gap-2 rounded-full border border-cream/25 px-4 py-2" data-same-day-tag>
        <span class="inline-flex h-4 w-4 shrink-0 items-center justify-center text-accent" aria-hidden="true">
          <SameDayTruck />
        </span>
        <span class="eyebrow">Entregas en el día</span>
      </span>
      <span class="eyebrow rounded-full border border-cream/25 px-4 py-2">AMBA · Argentina</span>
    </div>

    <Lines tag="h1" lines={["Tus envíos Flex,", "a tiempo.", "Siempre."]} accent={1} class="text-display-lg uppercase" delay={0.2} />

    <div class="mt-8 flex flex-col gap-8 sm:mt-12 md:flex-row md:items-end md:justify-between">
      <p class="max-w-md text-lg leading-relaxed text-cream/75" data-reveal="up" data-delay="0.6">
        Logística de última milla para vendedores de Mercado Libre. Dos recorridos diarios en CABA y GBA, con seguimiento en tiempo real.
      </p>
      <div class="flex flex-wrap gap-3" data-reveal="up" data-delay="0.75">
        <a href="/contacto?intent=services#formulario" class="btn-primary">
          Hablanos
        </a>
        <a href={FEATURES.pricing ? "/planes" : "/servicios"} class="btn-ghost">{FEATURES.pricing ? "Ver tarifas" : "Ver servicios"}</a>
      </div>
    </div>
  </Container>
</section>
