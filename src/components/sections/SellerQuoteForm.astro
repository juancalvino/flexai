---
import { Icon } from "astro-icon/components";
import { ZONE_LIST } from "../../data/zones";

// Package sizes stay within Mercado Envíos Flex limits (max 300 cm per side, 80 kg).
const sizes = [
  { value: "Pequeño", hint: "hasta 30 cm · ~5 kg" },
  { value: "Mediano", hint: "hasta 60 cm · ~15 kg" },
  { value: "Grande", hint: "hasta 80 cm · ~30 kg" },
];

const labelClass = "eyebrow text-ink/60";
const fieldClass =
  "mt-2 w-full rounded-xl border-ink/15 bg-cream-light px-4 py-3 text-ink placeholder:text-ink/35 focus:border-ink focus:ring-0";
const choiceCardClass =
  "flex cursor-pointer items-center gap-3 rounded-xl border border-ink/15 bg-cream px-4 py-3 transition-colors has-[:checked]:border-ink has-[:checked]:ring-1 has-[:checked]:ring-ink has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-accent";
---

<div id="seller-quote" class="rounded-3xl bg-cream-light p-8 ring-1 ring-ink/10 md:p-12" hidden>
  <p class="eyebrow text-secondary">Cotización</p>
  <h2 class="mt-4 font-display text-4xl uppercase">Consultá tu tarifa</h2>
  <p class="mt-3 text-ink/60">Contanos sobre tu operación y te respondemos con la tarifa por WhatsApp.</p>

  <form id="seller-quote-form" class="mt-8 grid gap-6 sm:grid-cols-2" novalidate>
    <label class="block">
      <span class={labelClass}>Zona *</span>
      <select name="zone" required class={fieldClass}>
        <option value="">Seleccioná tu zona</option>
        {ZONE_LIST.map((zone) => <option value={zone.name}>{zone.name}</option>)}
      </select>
    </label>

    <label class="block">
      <span class={labelClass}>Paquetes por día *</span>
      <input name="volume" type="number" min="1" step="1" required placeholder="Ej: 30" class={fieldClass} />
    </label>

    <label class="block">
      <span class={labelClass}>Nombre de la empresa *</span>
      <input name="company" type="text" required autocomplete="organization" placeholder="Ej: Tienda Ropa AMBA" class={fieldClass} />
    </label>

    <fieldset class="sm:col-span-2">
      <legend class={labelClass}>Tamaño promedio de tus paquetes *</legend>
      <div class="mt-2 grid gap-3 sm:grid-cols-3">
        {sizes.map((size) => (
          <label class={choiceCardClass}>
            <input type="radio" name="size" value={size.value} required class="size-4 shrink-0 accent-secondary" />
            <span>
              <span class="block font-display text-sm font-medium uppercase tracking-wider">{size.value}</span>
              <span class="block text-xs text-ink/60">{size.hint}</span>
            </span>
          </label>
        ))}
      </div>
      <p class="mt-2 text-xs text-ink/50">Siempre dentro del límite de Mercado Envíos Flex (máx. 300 cm por lado y 80 kg).</p>
    </fieldset>

    <p id="seller-quote-error" class="hidden text-sm text-red-700 sm:col-span-2" role="alert">
      Revisá los campos marcados con * antes de enviar.
    </p>

    <button type="submit" class="btn-dark sm:col-span-2">
      <Icon name="simple-icons:whatsapp" class="h-4 w-4" />
      Enviar por WhatsApp
    </button>
  </form>
</div>

<script>
  import { whatsappUrl } from "../../data/site";

  const wrap = document.getElementById("seller-quote")!;
  const form = document.getElementById("seller-quote-form") as HTMLFormElement;
  const error = document.getElementById("seller-quote-error")!;

  const open = () => {
    wrap.hidden = false;
    wrap.scrollIntoView({ behavior: "smooth", block: "start" });
    form.querySelector<HTMLElement>("select, input")?.focus();
  };

  document.querySelectorAll<HTMLElement>("[data-open-quote]").forEach((trigger) =>
    trigger.addEventListener("click", () => open()),
  );

  form.addEventListener("submit", (event) => {
    event.preventDefault();

    form.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input, select").forEach((field) => {
      field.setAttribute("aria-invalid", String(!field.checkValidity()));
      field.classList.toggle("!border-red-600", !field.checkValidity());
    });

    if (!form.checkValidity()) {
      error.classList.remove("hidden");
      form.querySelector<HTMLElement>(":invalid")?.focus();
      return;
    }

    const data = new FormData(form);
    const value = (key: string) => String(data.get(key) ?? "").trim();

    const lines = [
      "Hola FLEXAI, quiero consultar las tarifas.",
      `Zona: ${value("zone")}`,
      `Paquetes por día: ${value("volume")}`,
      `Tamaño de paquetes: ${value("size")}`,
      `Empresa: ${value("company")}`,
    ];

    window.open(whatsappUrl(lines.join("\n")), "_blank", "noopener");
  });
</script>
