---
import Container from "../container.astro";
import Lines from "../ui/Lines.astro";
import { ZONE_LIST } from "../../data/zones";

const localityCount = ZONE_LIST.reduce((total, zone) => total + zone.localities.length, 0);

const stats = [
  { value: 2, suffix: "", label: "Recorridos por día" },
  { value: 6, suffix: "", label: "Días a la semana" },
  { value: localityCount, suffix: "+", label: "Localidades en AMBA" },
  { value: 100, suffix: "%", label: "Entregas garantizadas" },
];
---

<section class="section bg-cream">
  <Container>
    <div class="grid gap-16 lg:grid-cols-[1fr_1.1fr] lg:gap-24">
      <div>
        <p class="eyebrow mb-6 text-ink/60" data-reveal="fade">Quiénes somos</p>
        <Lines lines={["Más que un", "proveedor,", "tu aliado."]} accent={2} class="text-display-sm uppercase" />
      </div>
      <div class="flex flex-col justify-end gap-6 text-lg leading-relaxed text-ink/70" data-reveal="up">
        <p>
          Sabemos que la logística define la experiencia de tus compradores. Por eso cuidamos cada paquete como si fuera nuestro y respaldamos tu reputación en Mercado Libre con entregas en el día.
        </p>
        <a href="/nosotros" class="self-start py-3 font-display text-sm uppercase tracking-wider text-ink underline decoration-accent decoration-2 underline-offset-8 transition-colors hover:text-secondary">
          Conocé FLEXAI
        </a>
      </div>
    </div>

    <dl class="mt-24 grid grid-cols-2 border-t border-ink/15 lg:grid-cols-4">
      {
        stats.map((stat, index) => (
          <div
            class:list={["flex flex-col border-b border-ink/15 py-10 pr-6 lg:border-b-0", index % 2 === 0 && "max-lg:border-r", index % 2 === 1 && "max-lg:pl-6", index < 3 && "lg:border-r"]}
            data-reveal="up"
            data-delay={index * 0.1}
          >
            <dt class="eyebrow order-2 mt-3 text-ink/50 lg:pl-8">{stat.label}</dt>
            <dd class="order-1 font-display text-6xl font-medium leading-none md:text-7xl lg:pl-8">
              <span data-count={stat.value} data-suffix={stat.suffix}>
                {stat.value}
                {stat.suffix}
              </span>
            </dd>
          </div>
        ))
      }
    </dl>
  </Container>
</section>
