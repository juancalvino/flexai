---
import Container from "../container.astro";
import Sectionhead from "../sectionhead.astro";
import { STEPS } from "../../data/services";
---

<section class="section bg-cream-light">
  <Container>
    <Sectionhead eyebrow="Cómo funciona" title={["Tres pasos.", "Cero vueltas."]} accent={1} class="mb-20" />
    <ol class="grid gap-px overflow-hidden rounded-3xl bg-ink/10 md:grid-cols-3">
      {
        STEPS.map((step, index) => (
          <li class="flex min-h-[280px] flex-col justify-between gap-12 bg-cream-light p-8 md:p-10" data-reveal="up" data-delay={index * 0.12}>
            <span class="font-display text-8xl font-medium leading-none text-brand-yellow-500">0{index + 1}</span>
            <div>
              <h3 class="font-display text-3xl uppercase">{step.title}</h3>
              <p class="mt-3 text-ink/65">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Container>
</section>
