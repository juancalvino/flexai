---
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
import Lines from "../components/ui/Lines.astro";
import { NAVIGATION } from "../data/site";
---

<Layout title="Página no encontrada" noIndex>
  <section class="flex min-h-[100svh] items-center bg-ink pt-20 text-cream">
    <Container>
      <p class="eyebrow mb-8 text-brand-yellow-500">Error 404</p>
      <Lines tag="h1" lines={["Este paquete", "se perdió", "en el camino."]} accent={1} class="text-display-md uppercase" />
      <p class="mt-10 max-w-lg text-lg text-cream/70" data-reveal="up" data-delay="0.3">
        La página que buscás no existe o cambió de dirección. Te ayudamos a encontrar tu destino.
      </p>
      <div class="mt-10 flex flex-wrap gap-3" data-reveal="up" data-delay="0.4">
        <a href="/" class="btn-primary">Volver al inicio</a>
        {NAVIGATION.slice(1).map((item) => <a href={item.path} class="btn-ghost">{item.title}</a>)}
      </div>
    </Container>
  </section>
</Layout>
