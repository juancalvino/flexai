---
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
import Sectionhead from "../components/sectionhead.astro";
import PageHero from "../components/sections/PageHero.astro";
import GeoJSONMap from "../components/GeoJSONMap.astro";
import ContactCta from "../components/sections/ContactCta.astro";
import { ZONE_LIST } from "../data/zones";
import { FEATURES } from "../data/features";
---

<Layout
  title="Cobertura"
  description={FEATURES.pricing
    ? "Zonas de entrega de FLEXAI en CABA y GBA. Consultá el mapa interactivo y la tarifa de cada zona."
    : "Zonas de entrega de FLEXAI en CABA y GBA. Consultá el mapa interactivo y tu zona de cobertura."}
>
  <PageHero eyebrow="Cobertura · AMBA" title={["Llegamos a", "donde vende", "tu tienda."]} accent={2}>
    <p>
      {FEATURES.pricing
        ? "Todas las zonas habilitadas por Mercado Libre en CABA y el conurbano, organizadas en cuatro zonas de tarifa."
        : "Todas las zonas habilitadas por Mercado Libre en CABA y el conurbano, organizadas en cuatro zonas de cobertura."}
    </p>
  </PageHero>

  <section class="bg-ink pb-24 text-cream md:pb-36">
    <Container>
      <GeoJSONMap />
    </Container>
  </section>

  <section class="section bg-cream">
    <Container>
      <Sectionhead eyebrow="Zonas cubiertas" title={["Localidad", "por localidad."]} accent={1} class="mb-16" />
      <div class="divide-y divide-ink/10 border-y border-ink/10">
        {
          ZONE_LIST.map((zone) => (
            <div class="grid gap-4 py-10 md:grid-cols-[240px_1fr]" data-reveal="up">
              <div class="flex items-center gap-4">
                <span class="h-4 w-4 rounded-full ring-1 ring-ink/20" style={`background:${zone.color}`} />
                <h3 class="font-display text-3xl uppercase">{zone.name}</h3>
              </div>
              <p class="text-lg leading-relaxed text-ink/70">{zone.localities.join(" · ")}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <ContactCta />
</Layout>
