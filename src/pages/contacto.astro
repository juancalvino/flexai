---
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
import PageHero from "../components/sections/PageHero.astro";
import ContactForm from "../components/ContactForm.astro";
---

<Layout title="Contacto" description="Elegí entre contratar el servicio de envíos o trabajar con FLEXAI y te contactamos por WhatsApp.">
  <PageHero eyebrow="Contacto" title={["¿Cómo podemos", "ayudarte?"]} accent={1}>
    <p>Contanos qué necesitás. Ya sea para tus envíos o para sumarte al equipo, seguimos la conversación por WhatsApp.</p>
  </PageHero>

  <section class="section bg-cream">
    <Container>
      <div data-reveal="up" data-delay="0.1" class="mx-auto max-w-3xl">
        <ContactForm />
      </div>
    </Container>
  </section>
</Layout>
