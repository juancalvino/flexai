---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
import Sectionhead from "../components/sectionhead.astro";
import PageHero from "../components/sections/PageHero.astro";
import ServicesSection from "../components/sections/ServicesSection.astro";
import ContactCta from "../components/sections/ContactCta.astro";
import { PLANS, ZONE_LIST, formatPrice, type PlanId } from "../data/zones";
import { DIFFERENTIATORS } from "../data/services";
import { whatsappUrl } from "../data/site";

const planIds: PlanId[] = ["standard", "pro"];
---

<Layout title="Servicios y tarifas" description="Planes Standard y Pro para vendedores de Mercado Libre. Tarifas por zona para CABA y GBA, sin costos ocultos.">
  <PageHero eyebrow="Servicios · Tarifas" title={["Tarifas claras.", "Sin sorpresas."]} accent={1}>
    <p>Elegí el plan según tu volumen diario. Todas las tarifas son por paquete y por zona de entrega.</p>
  </PageHero>

  <section class="section bg-cream" id="tarifas">
    <Container>
      <div class="grid gap-6 lg:grid-cols-2">
        {
          planIds.map((planId, index) => {
            const plan = PLANS[planId];
            const featured = planId === "pro";
            return (
              <article
                class:list={[
                  "flex flex-col rounded-3xl p-8 md:p-12",
                  featured ? "bg-ink text-cream" : "bg-cream-light ring-1 ring-ink/10",
                ]}
                data-reveal="up"
                data-delay={index * 0.12}
              >
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <p class:list={["eyebrow", featured ? "text-brand-yellow-500" : "text-ink/50"]}>{plan.volume}</p>
                    <h2 class="mt-4 font-display text-5xl uppercase leading-none">{plan.name}</h2>
                  </div>
                  {featured && <span class="eyebrow rounded-full bg-brand-yellow-500 px-3 py-1.5 text-ink">Mejor tarifa</span>}
                </div>
                <p class:list={["mt-4", featured ? "text-cream/60" : "text-ink/60"]}>{plan.highlight}</p>

                <dl class:list={["mt-10 flex-1 divide-y", featured ? "divide-cream/10" : "divide-ink/10"]}>
                  {ZONE_LIST.map((zone) => (
                    <div class="flex items-baseline justify-between py-4">
                      <dt class="font-display text-lg uppercase">{zone.name}</dt>
                      <dd class="font-display text-3xl">{formatPrice(zone.prices[planId])}</dd>
                    </div>
                  ))}
                </dl>

                <a
                  href={whatsappUrl(`Hola FLEXAI, quiero contratar el plan ${plan.name}.`)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={["mt-10 w-full", featured ? "btn-primary" : "btn-dark"]}
                >
                  Quiero el plan {plan.name.split(" ")[0]}
                </a>
              </article>
            );
          })
        }
      </div>
      <p class="mt-6 text-sm text-ink/50">* Precios por paquete. IVA no incluido.</p>

      <aside class="mt-16 flex flex-col gap-6 rounded-3xl bg-brand-yellow-500 p-8 md:flex-row md:items-center md:p-12" data-reveal="up">
        <Icon name="bx:group" class="h-12 w-12 shrink-0" />
        <div>
          <h2 class="font-display text-2xl uppercase">Sumá envíos con otros comercios</h2>
          <p class="mt-2 max-w-3xl text-ink/75">
            Si combinás tus envíos con los de comercios cercanos y juntos alcanzan un mayor volumen, pueden acceder a un plan superior con tarifas más bajas.
          </p>
        </div>
      </aside>
    </Container>
  </section>

  <ServicesSection />

  <section class="section bg-cream">
    <Container>
      <Sectionhead eyebrow="Por qué FLEXAI" title={["Tu reputación,", "en buenas manos."]} accent={1} class="mb-16" />
      <ul class="grid gap-6 md:grid-cols-3">
        {
          DIFFERENTIATORS.map((item, index) => (
            <li class="rounded-3xl bg-cream-light p-8 ring-1 ring-ink/10" data-reveal="up" data-delay={index * 0.1}>
              <Icon name={item.icon} class="h-10 w-10 text-brand-blue-500" />
              <h3 class="mt-8 font-display text-2xl uppercase">{item.title}</h3>
              <p class="mt-3 text-ink/65">{item.description}</p>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <ContactCta />
</Layout>
